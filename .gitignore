# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Cloned source repositories (gigabytes of kernel, buildroot, and vitasdk git trees)
sources/*
!sources/.gitkeep

# Build and downloaded output artifacts
output/*
!output/.gitkeep

# Temporary build directories & files
.tmp*
*.tmp
*.log

# Compiled binaries and kernels
*.bin
*.elf
*.skprx
*.vpk
*.cpio.xz
*.cpio.zst
*.zst
*.tar.gz
*.dtb
zImage
uImage

# Compiled tools
tools/fbkeyboard/fbkeyboard
tools/vita-input-mapper/vita-input-mapper
tools/fbdoom/fbdoom
rootfs-overlay/usr/bin/fbkeyboard
rootfs-overlay/usr/bin/vita-input-mapper
rootfs-overlay/usr/bin/fbdoom
rootfs-overlay/lib/
tools/**/*.map

# Sensitive local configurations
configs/wifi.conf
rootfs-overlay/etc/wpa_supplicant.conf
rootfs-overlay/root/.ssh/

# Object files & dependency lists
*.o
*.a
*.so
tools/**/*.d
!*.d/
!rootfs-overlay/etc/init.d/
!rootfs-overlay/etc/profile.d/

# Editor and IDE directories
.vscode/
.idea/
*.swp
*~

# Antigravity & AI workspace local rules and customizations
.antigravity/
.agents/
.gemini/
AGENTS.md
GEMINI.md
