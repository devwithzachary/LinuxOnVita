diff --git a/arch/arm/boot/dts/vita1000.dts b/arch/arm/boot/dts/vita1000.dts
index ec05ab2a0..b67777c3c 100644
--- a/arch/arm/boot/dts/vita1000.dts
+++ b/arch/arm/boot/dts/vita1000.dts
@@ -11,6 +11,9 @@
 #include "vita.dtsi"
 
 / {
+	model = "Sony PlayStation Vita 1000 (OLED)";
+	compatible = "sony,vita1000", "vita,vita";
+
 	chosen {
 		bootargs = "earlyprintk keep_bootcon console=tty0 console=ttyS0,115200";
 
@@ -30,16 +33,23 @@ &i2c0 {
 	status = "okay";
 };
 
-/* I2C1 disabled - bus scan empty on PCH-1000 (no powered consumers) */
+&i2c1 {
+	status = "okay";
+};
 
-/* SDIF0 = eMMC, SDIF2 = WLAN/BT (SD8787 via SDIO) */
+/* SDIF0 = eMMC, SDIF1 = Game card / SD2Vita, SDIF2 = WLAN/BT, SDIF3 = Memory Card */
 &sdif0 {
 	status = "okay";
 };
 
-/* SDIF1 (game card) and SDIF3 (microSD/SD2Vita) disabled --
- * no cards present, and polling creates log spam */
+&sdif1 {
+	status = "okay";
+};
 
 &sdif2 {
 	status = "okay";
 };
+
+&sdif3 {
+	status = "okay";
+};
