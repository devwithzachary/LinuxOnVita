From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vita Linux Port <dev@vita-linux.org>
Date: Tue, 22 Sep 2026 16:36:00 +0100
Subject: [PATCH] Multi-path payload loading, 100% display brightness, and battery state persistence

---
 config.h |  2 +-
 main.c   | 46 ++++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/config.h b/config.h
index e823b0a..c768aa0 100644
--- a/config.h
+++ b/config.h
@@ -1,2 +1,2 @@
-#define PAYLOAD_PATH	"ux0:/baremetal/payload.bin"
+#define PAYLOAD_PATH	"ux0:linux/payload.bin"
 #define PAYLOAD_PADDR	0x40300000
diff --git a/main.c b/main.c
index ffa2a2c..9dafee9 100644
--- a/main.c
+++ b/main.c
@@ -179,9 +179,27 @@ int module_start(SceSize argc, const void *args)
 	/*
 	 * Load the baremetal payload to physically contiguous memory.
 	 */
-	ret = load_file_phycont(PAYLOAD_PATH, &payload_uid, &payload_vaddr, &payload_size);
+	static const char * const payload_paths[] = {
+		PAYLOAD_PATH,
+		"ux0:linux/payload.bin",
+		"ux0:/linux/payload.bin",
+		"ux0:baremetal/payload.bin",
+		"ux0:/baremetal/payload.bin",
+		"uma0:linux/payload.bin",
+		"uma0:/linux/payload.bin",
+		"imc0:linux/payload.bin",
+		"imc0:/linux/payload.bin",
+	};
+	ret = -1;
+	for (unsigned int i = 0; i < sizeof(payload_paths) / sizeof(payload_paths[0]); i++) {
+		ret = load_file_phycont(payload_paths[i], &payload_uid, &payload_vaddr, &payload_size);
+		if (ret >= 0) {
+			LOG("Loaded payload from %s\n", payload_paths[i]);
+			break;
+		}
+	}
 	if (ret < 0) {
-		LOG("Error loading " PAYLOAD_PATH ": 0x%08X\n", ret);
+		LOG("Error loading payload from any path: 0x%08X\n", ret);
 		return SCE_KERNEL_START_FAILED;
 	}
 
@@ -236,6 +254,32 @@ int module_start(SceSize argc, const void *args)
 	ksceKernelGetPaddr(&resume_ctx, &resume_ctx_paddr);
 	LOG("Resume context pa: 0x%08X\n", resume_ctx_paddr);
 
+	/* Set display to 100% full brightness */
+	kscePowerSetDisplayBrightness(65535);
+
+	/* Capture hardware battery state */
+	int batt_percent = kscePowerGetBatteryLifePercent();
+	int batt_charging = kscePowerIsBatteryCharging();
+	int batt_volt = kscePowerGetBatteryVolt();
+	LOG("Battery: %d%%, charging: %d, volt: %dmV\n", batt_percent, batt_charging, batt_volt);
+
+	static const char * const batt_paths[] = {
+		"ux0:linux/battery.txt",
+		"ur0:linux/battery.txt",
+		"ux0:/linux/battery.txt",
+		"ur0:/linux/battery.txt"
+	};
+	for (unsigned int b = 0; b < sizeof(batt_paths)/sizeof(batt_paths[0]); b++) {
+		SceUID bfd = ksceIoOpen(batt_paths[b], SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+		if (bfd >= 0) {
+			char bbuf[128];
+			int blen = snprintf(bbuf, sizeof(bbuf), "PERCENT=%d\nCHARGING=%d\nVOLTAGE_MV=%d\n",
+				batt_percent, batt_charging, batt_volt);
+			ksceIoWrite(bfd, bbuf, blen);
+			ksceIoClose(bfd);
+		}
+	}
+
 	LOG("Requesting standby...\n");
 
 	kscePowerRequestStandby();
-- 
