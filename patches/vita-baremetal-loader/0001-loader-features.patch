From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DevWithZachary <devwithzachary@pm.me>
Date: Tue, 22 Sep 2026 16:36:00 +0100
Subject: [PATCH] Multi-path payload loading and 100% display brightness

---
 config.h |  2 +-
 main.c   | 21 ++++++++++++++++++++-
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/config.h b/config.h
index e823b0a..c768aa0 100644
--- a/config.h
+++ b/config.h
@@ -1,2 +1,2 @@
-#define PAYLOAD_PATH	"ux0:/baremetal/payload.bin"
+#define PAYLOAD_PATH	"ux0:linux/payload.bin"
 #define PAYLOAD_PADDR	0x40300000
diff --git a/main.c b/main.c
index ffa2a2c..bcc98a9 100644
--- a/main.c
+++ b/main.c
@@ -179,9 +179,31 @@ int module_start(SceSize argc, const void *args)
 	/*
 	 * Load the baremetal payload to physically contiguous memory.
 	 */
-	ret = load_file_phycont(PAYLOAD_PATH, &payload_uid, &payload_vaddr, &payload_size);
+	static const char * const payload_paths[] = {
+		PAYLOAD_PATH,
+		"ux0:linux/payload.bin",
+		"ux0:/linux/payload.bin",
+		"ux0:baremetal/payload.bin",
+		"ux0:/baremetal/payload.bin",
+		"xmc0:linux/payload.bin",
+		"xmc0:/linux/payload.bin",
+		"uma0:linux/payload.bin",
+		"uma0:/linux/payload.bin",
+		"imc0:linux/payload.bin",
+		"imc0:/linux/payload.bin",
+		"ur0:linux/payload.bin",
+		"ur0:/linux/payload.bin",
+	};
+	ret = -1;
+	for (unsigned int i = 0; i < sizeof(payload_paths) / sizeof(payload_paths[0]); i++) {
+		ret = load_file_phycont(payload_paths[i], &payload_uid, &payload_vaddr, &payload_size);
+		if (ret >= 0) {
+			LOG("Loaded payload from %s\n", payload_paths[i]);
+			break;
+		}
+	}
 	if (ret < 0) {
-		LOG("Error loading " PAYLOAD_PATH ": 0x%08X\n", ret);
+		LOG("Error loading payload from any path: 0x%08X\n", ret);
 		return SCE_KERNEL_START_FAILED;
 	}
 
@@ -236,6 +254,9 @@ int module_start(SceSize argc, const void *args)
 	ksceKernelGetPaddr(&resume_ctx, &resume_ctx_paddr);
 	LOG("Resume context pa: 0x%08X\n", resume_ctx_paddr);
 
+	/* Set display to 100% full brightness */
+	kscePowerSetDisplayBrightness(65535);
+
 	LOG("Requesting standby...\n");
 
 	kscePowerRequestStandby();
-- 
