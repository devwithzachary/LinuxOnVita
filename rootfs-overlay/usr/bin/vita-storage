#!/bin/sh
# vita-storage: PlayStation Vita Storage Safety & Mount Management Tool
# Centralized utility for mount discovery, read-only protection, and remounts.

is_mounted() {
    target="$1"
    case "$target" in
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac
    grep -qs " ${target} " /proc/mounts
}

is_ro() {
    target="$1"
    case "$target" in
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac

    if ! is_mounted "$target"; then
        return 1
    fi

    if grep -E -q " ${target} [^ ]+ (ro|.*,ro)( |$|,)" /proc/mounts 2>/dev/null || \
       awk -v m="$target" '$2 == m { if ($4 ~ /(^|,)ro(,|$)/) f=1 } END { exit (f ? 0 : 1) }' /proc/mounts 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

get_fs_type() {
    target="$1"
    case "$target" in
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac
    awk -v m="$target" '$2 == m { print $3 }' /proc/mounts
}

get_device() {
    target="$1"
    case "$target" in
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac
    awk -v m="$target" '$2 == m { print $1 }' /proc/mounts
}

get_default_mode() {
    target="$1"
    for conf in "/mnt/ux0/linux/storage.conf" "/mnt/ur0/linux/storage.conf" "/etc/vita-storage.conf"; do
        if [ -f "$conf" ]; then
            val=$(grep -E "^${target}_mode=" "$conf" 2>/dev/null | cut -d= -f2 | tr -d ' "')
            [ -z "$val" ] && val=$(grep -E "^default_mode=" "$conf" 2>/dev/null | cut -d= -f2 | tr -d ' "')
            if [ "$val" = "rw" ]; then
                echo "rw"
                return 0
            fi
        fi
    done
    echo "ro"
}

set_default_mode() {
    mode="$1"
    case "$mode" in
        ro|rw) ;;
        *)
            echo "Error: Invalid mode '$mode' (use 'ro' or 'rw')" >&2
            return 1
            ;;
    esac

    saved=0
    for dir in /mnt/ux0 /mnt/ur0; do
        if is_mounted "$dir"; then
            m_label="${dir##/mnt/}"
            was_ro=0
            if is_ro "$m_label"; then
                remount_rw "$m_label" >/dev/null 2>&1 && was_ro=1
            fi

            mkdir -p "${dir}/linux" 2>/dev/null
            cat << EOF > "${dir}/linux/storage.conf"
# LinuxOnVita Storage Protection Configuration
default_mode=${mode}
ux0_mode=${mode}
ur0_mode=${mode}
EOF
            sync
            if [ $was_ro -eq 1 ]; then
                remount_ro "$m_label" >/dev/null 2>&1 || true
            fi
            saved=1
        fi
    done

    mkdir -p /etc 2>/dev/null
    cat << EOF > /etc/vita-storage.conf
# LinuxOnVita Storage Protection Configuration
default_mode=${mode}
ux0_mode=${mode}
ur0_mode=${mode}
EOF

    if [ "$saved" -eq 1 ]; then
        [ "$QUIET" != "1" ] && echo "Default boot mount mode set to: [${mode}] (saved to storage)"
    else
        [ "$QUIET" != "1" ] && echo "Default boot mount mode set to: [${mode}] (session RAM only)"
    fi
}

mount_partition() {
    target="$1"
    case "$target" in
        all)
            mount_partition ur0
            mount_partition ux0
            return 0
            ;;
        /mnt/ux0|ux0)
            mkdir -p /mnt/ux0
            if is_mounted /mnt/ux0; then
                return 0
            fi
            mode=$(get_default_mode ux0)
            for dev in /dev/vita/ux0 /dev/mmcblk1p1 /dev/mmcblk1 /dev/mmcblk2p1 /dev/mmcblk2; do
                if [ -b "$dev" ]; then
                    [ -L /dev/vita/ux0 ] || ln -sf "$dev" /dev/vita/ux0 2>/dev/null || true
                    mount -t exfat -o "$mode" "$dev" /mnt/ux0 2>/dev/null || \
                    mount -t vfat -o "$mode" "$dev" /mnt/ux0 2>/dev/null || \
                    mount -t ext4 -o "$mode" "$dev" /mnt/ux0 2>/dev/null || \
                    mount -o "$mode" "$dev" /mnt/ux0 2>/dev/null || true
                    break
                fi
            done
            is_mounted /mnt/ux0
            return $?
            ;;
        /mnt/ur0|ur0)
            mkdir -p /mnt/ur0
            if is_mounted /mnt/ur0; then
                return 0
            fi
            mode=$(get_default_mode ur0)
            for dev in /dev/vita/ur0 /dev/mmcblk0p12; do
                if [ -b "$dev" ]; then
                    [ -L /dev/vita/ur0 ] || ln -sf "$dev" /dev/vita/ur0 2>/dev/null || true
                    mount -t exfat -o "$mode" "$dev" /mnt/ur0 2>/dev/null || \
                    mount -t vfat -o "$mode" "$dev" /mnt/ur0 2>/dev/null || \
                    mount -t ext4 -o "$mode" "$dev" /mnt/ur0 2>/dev/null || \
                    mount -o "$mode" "$dev" /mnt/ur0 2>/dev/null || true
                    break
                fi
            done
            is_mounted /mnt/ur0
            return $?
            ;;
        *)
            echo "Error: Unknown mount target '$target' (use ux0, ur0, or all)" >&2
            return 1
            ;;
    esac
}

show_status() {
    echo "================================================================"
    echo "         PlayStation Vita Storage Protection Status             "
    echo "================================================================"
    echo ""
    for label in ux0 ur0; do
        target="/mnt/${label}"
        if is_mounted "$target"; then
            fstype=$(get_fs_type "$target")
            dev=$(get_device "$target")
            usage=$(df -h "$target" 2>/dev/null | awk 'NR==2 { print $4 " free of " $2 }')

            if is_ro "$target"; then
                echo "  ${label} ($target): [PROTECTED - READ-ONLY]"
            else
                echo "  ${label} ($target): [UNPROTECTED - READ-WRITE]"
            fi
            echo "    Device:     $dev ($fstype)"
            echo "    Space:      $usage"
        else
            echo "  ${label} ($target): [NOT MOUNTED]"
        fi
        echo ""
    done
    def_mode=$(get_default_mode ux0)
    if [ "$def_mode" = "rw" ]; then
        echo "Default Boot Mode:  [UNPROTECTED - READ-WRITE]"
    else
        echo "Default Boot Mode:  [PROTECTED - SAFE READ-ONLY]"
    fi
    echo ""
    echo "Safety Note: Storage volumes are mounted read-only by default"
    echo "to protect VitaOS database and filesystem integrity from power loss."
    echo "================================================================"
}

remount_rw() {
    target="$1"
    case "$target" in
        all)
            remount_rw ur0
            remount_rw ux0
            return 0
            ;;
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac
    label="${target##/mnt/}"

    if ! is_mounted "$target"; then
        mount_partition "$label" >/dev/null 2>&1
        if ! is_mounted "$target"; then
            [ "$QUIET" != "1" ] && echo "Error: $target is not mounted and device was not found." >&2
            return 1
        fi
    fi

    if ! is_ro "$target"; then
        # Already read-write
        return 0
    fi

    [ "$QUIET" != "1" ] && echo "Remounting $target read-write..."
    if mount -o remount,rw "$target" 2>/dev/null; then
        if [ "$QUIET" != "1" ]; then
            echo "Success: $target is now read-write."
            echo ""
            echo "WARNING: Writing to VitaOS partitions carries filesystem corruption"
            echo "risk if interrupted. Run 'vita-storage ro ${label}' when done,"
            echo "or use 'vita-reboot' to return safely to VitaOS."
        fi
        return 0
    else
        [ "$QUIET" != "1" ] && echo "Error: Failed to remount $target read-write." >&2
        return 1
    fi
}

remount_ro() {
    target="$1"
    case "$target" in
        all)
            remount_ro ux0
            remount_ro ur0
            return 0
            ;;
        ux0) target="/mnt/ux0" ;;
        ur0) target="/mnt/ur0" ;;
    esac
    label="${target##/mnt/}"

    if ! is_mounted "$target"; then
        return 0
    fi

    if is_ro "$target"; then
        # Already read-only
        return 0
    fi

    [ "$QUIET" != "1" ] && echo "Syncing filesystem caches for $target..."
    sync
    if mount -o remount,ro "$target" 2>/dev/null; then
        [ "$QUIET" != "1" ] && echo "Success: $target is now locked in safe read-only mode."
        return 0
    else
        [ "$QUIET" != "1" ] && echo "Error: Could not remount $target read-only (files may be open in use)." >&2
        return 1
    fi
}

show_help() {
    cat << 'EOF'
Usage: vita-storage [COMMAND] [TARGET] [OPTIONS]

PlayStation Vita Storage Protection & Mount Utility.

Commands:
  status               Display mount and protection status (default)
  mount [ux0|ur0|all]  Mount partition(s) in safe read-only mode if unmounted
  ro [ux0|ur0|all]     Sync and remount partition in safe read-only mode
  rw [ux0|ur0|all]     Remount partition in read-write mode
  is-ro [ux0|ur0]      Check if partition is mounted read-only (exit 0=yes, 1=no)
  is-rw [ux0|ur0]      Check if partition is mounted read-write (exit 0=yes, 1=no)
  is-mounted [ux0|ur0] Check if partition is mounted (exit 0=yes, 1=no)
  set-default [ro|rw]  Set default boot mount protection mode (saved to storage)
  sync                 Flush all disk caches to physical storage
  help                 Display this help screen

Options:
  -q, --quiet          Suppress status messages (useful for scripts)

Examples:
  vita-storage status
  vita-storage mount all
  vita-storage rw ux0          # Temporarily allow writes to SD2Vita
  vita-storage ro ux0          # Lock SD2Vita back down to read-only
  vita-storage set-default ro  # Ensure partitions boot read-only (Safe)
EOF
}

# Parse options
QUIET=0
ARGS=""
for arg in "$@"; do
    case "$arg" in
        -q|--quiet)
            QUIET=1
            ;;
        *)
            ARGS="${ARGS} ${arg}"
            ;;
    esac
done

set -- $ARGS
ACTION="${1:-status}"
TARGET_ARG="${2:-ux0}"

case "$ACTION" in
    status)
        show_status
        ;;
    sync)
        [ "$QUIET" != "1" ] && echo "Flushing disk caches..."
        sync
        [ "$QUIET" != "1" ] && echo "Sync complete."
        ;;
    mount)
        mount_partition "$TARGET_ARG"
        ;;
    ro)
        remount_ro "$TARGET_ARG"
        ;;
    rw)
        remount_rw "$TARGET_ARG"
        ;;
    set-default|default|mode)
        set_default_mode "$TARGET_ARG"
        ;;
    is-ro)
        is_ro "$TARGET_ARG"
        ;;
    is-rw)
        if is_mounted "$TARGET_ARG" && ! is_ro "$TARGET_ARG"; then
            exit 0
        else
            exit 1
        fi
        ;;
    is-mounted)
        if is_mounted "$TARGET_ARG"; then
            exit 0
        else
            exit 1
        fi
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
