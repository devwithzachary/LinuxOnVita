#!/bin/sh
# vita-led: PlayStation Vita PS Button LED Configuration & Trigger Daemon
# Controls /sys/class/leds/gpio-led-ps-button-blue trigger modes

CONF_SYS="/etc/vita-led.conf"
CONF_UX0="/mnt/ux0/linux/led.conf"

QUIET=0
for arg in "$@"; do
    case "$arg" in
        -q|--quiet) QUIET=1 ;;
    esac
done

# ANSI Colors
if [ -t 1 ] && [ "$QUIET" -eq 0 ]; then
    C_CYAN="\033[1;36m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_WHITE="\033[1;37m"
    C_RESET="\033[0m"
else
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_WHITE=""
    C_RESET=""
fi

find_led_dir() {
    if [ -d "/sys/class/leds/gpio-led-ps-button-blue" ]; then
        echo "/sys/class/leds/gpio-led-ps-button-blue"
        return
    fi
    for d in /sys/class/leds/*ps-button* /sys/class/leds/*blue*; do
        if [ -d "$d" ]; then
            echo "$d"
            return
        fi
    done
    echo ""
}

LED_DIR=$(find_led_dir)

save_config() {
    local mode="$1"
    local trigger="$2"
    local brightness="$3"

    cat <<EOF > "$CONF_SYS" 2>/dev/null || true
# PlayStation Vita LED Configuration
mode=${mode}
trigger=${trigger}
brightness=${brightness}
EOF

    if [ -d /mnt/ux0/linux ]; then
        local was_ro=0
        if command -v vita-storage >/dev/null 2>&1 && vita-storage is-ro ux0 2>/dev/null; then
            vita-storage rw ux0 -q 2>/dev/null && was_ro=1
        fi
        cat <<EOF > "$CONF_UX0" 2>/dev/null || true
# PlayStation Vita LED Configuration
mode=${mode}
trigger=${trigger}
brightness=${brightness}
EOF
        sync 2>/dev/null || true
        if [ "$was_ro" -eq 1 ] && command -v vita-storage >/dev/null 2>&1; then
            vita-storage ro ux0 -q 2>/dev/null || true
        fi
    fi
}

show_status() {
    if [ -z "$LED_DIR" ] || [ ! -d "$LED_DIR" ]; then
        echo "Error: No PlayStation Vita LED sysfs node found."
        echo "Make sure gpio-led-ps-button-blue is registered in Device Tree."
        return 1
    fi

    local led_name
    led_name=$(basename "$LED_DIR")
    local cur_trigger=""
    if [ -f "$LED_DIR/trigger" ]; then
        cur_trigger=$(grep -o '\[[^]]*\]' "$LED_DIR/trigger" 2>/dev/null | tr -d '[]')
        [ -z "$cur_trigger" ] && cur_trigger="none"
    fi
    local cur_bright=0
    [ -f "$LED_DIR/brightness" ] && cur_bright=$(cat "$LED_DIR/brightness" 2>/dev/null || echo "0")

    printf "${C_CYAN}==================================================${C_RESET}\n"
    printf "${C_WHITE} PlayStation Vita LED Status${C_RESET}\n"
    printf "${C_CYAN}==================================================${C_RESET}\n"
    printf " LED Device:       ${C_GREEN}%s${C_RESET}\n" "$led_name"
    printf " Active Trigger:   ${C_YELLOW}%s${C_RESET}\n" "$cur_trigger"
    printf " Brightness:       ${C_WHITE}%s${C_RESET}\n" "$cur_bright"
    printf " Sysfs Node:       %s\n" "$LED_DIR"
    printf "${C_CYAN}--------------------------------------------------${C_RESET}\n"
    printf " Available Triggers:\n"
    if [ -f "$LED_DIR/trigger" ]; then
        cat "$LED_DIR/trigger" 2>/dev/null
        echo ""
    else
        echo " (trigger file unavailable)"
    fi
    printf "${C_CYAN}==================================================${C_RESET}\n"
    return 0
}

set_led_mode() {
    local target_mode="$1"
    local raw_trigger="$2"

    if [ -z "$LED_DIR" ] || [ ! -d "$LED_DIR" ]; then
        [ "$QUIET" -eq 0 ] && echo "Error: LED sysfs node not found."
        return 1
    fi

    case "$target_mode" in
        heartbeat)
            if [ -f "$LED_DIR/trigger" ]; then
                echo "heartbeat" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "heartbeat" "heartbeat" "1"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED set to Heartbeat pulse (CPU load rhythm)."
            ;;
        disk|storage|activity)
            local chosen="none"
            if [ -f "$LED_DIR/trigger" ]; then
                if grep -qw "mmc0" "$LED_DIR/trigger" 2>/dev/null; then
                    chosen="mmc0"
                elif grep -qw "disk-activity" "$LED_DIR/trigger" 2>/dev/null; then
                    chosen="disk-activity"
                elif grep -qw "activity" "$LED_DIR/trigger" 2>/dev/null; then
                    chosen="activity"
                fi
                echo "$chosen" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "disk" "$chosen" "1"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED set to Storage/Disk I/O activity (${chosen})."
            ;;
        cpu)
            local chosen="activity"
            if [ -f "$LED_DIR/trigger" ]; then
                if grep -qw "activity" "$LED_DIR/trigger" 2>/dev/null; then
                    chosen="activity"
                elif grep -qw "cpu" "$LED_DIR/trigger" 2>/dev/null; then
                    chosen="cpu"
                fi
                echo "$chosen" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "cpu" "$chosen" "1"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED set to CPU instant activity (${chosen})."
            ;;
        on|solid)
            if [ -f "$LED_DIR/trigger" ]; then
                echo "none" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "on" "none" "1"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED turned ON (steady blue glow)."
            ;;
        off)
            if [ -f "$LED_DIR/trigger" ]; then
                echo "none" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 0 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "off" "none" "0"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED turned OFF."
            ;;
        custom)
            if [ -z "$raw_trigger" ]; then
                echo "Error: Must specify trigger name for 'set'."
                return 1
            fi
            if [ -f "$LED_DIR/trigger" ]; then
                echo "$raw_trigger" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            save_config "custom" "$raw_trigger" "1"
            [ "$QUIET" -eq 0 ] && echo "PS Button LED trigger set to '${raw_trigger}'."
            ;;
        apply)
            local read_mode=""
            local read_trigger=""
            local read_bright=""

            # Prefer UX0 config if present, else SYS
            local cfg=""
            if [ -f "$CONF_UX0" ]; then
                cfg="$CONF_UX0"
            elif [ -f "$CONF_SYS" ]; then
                cfg="$CONF_SYS"
            fi

            if [ -n "$cfg" ]; then
                read_mode=$(grep '^mode=' "$cfg" 2>/dev/null | cut -d= -f2 | tr -d ' \r\n')
                read_trigger=$(grep '^trigger=' "$cfg" 2>/dev/null | cut -d= -f2 | tr -d ' \r\n')
                read_bright=$(grep '^brightness=' "$cfg" 2>/dev/null | cut -d= -f2 | tr -d ' \r\n')
            fi

            if [ -n "$read_mode" ]; then
                case "$read_mode" in
                    heartbeat|disk|activity|cpu|on|off)
                        set_led_mode "$read_mode"
                        return $?
                        ;;
                    custom)
                        [ -n "$read_trigger" ] && set_led_mode "custom" "$read_trigger"
                        return $?
                        ;;
                esac
            fi

            # Default fallback if no config: steady on
            if [ -f "$LED_DIR/trigger" ]; then
                echo "none" > "$LED_DIR/trigger" 2>/dev/null || true
            fi
            echo 1 > "$LED_DIR/brightness" 2>/dev/null || true
            [ "$QUIET" -eq 0 ] && echo "PS Button LED initialized to default (ON)."
            ;;
        *)
            echo "Usage: vita-led [heartbeat | disk | activity | cpu | on | off | set <trigger> | status | apply]"
            echo ""
            echo "Commands:"
            echo "  status         - Display current active LED trigger and hardware status"
            echo "  heartbeat      - Set rhythmic pulse matching CPU load heartbeat"
            echo "  disk           - Blink on SD card and storage I/O activity (mmc0)"
            echo "  activity       - Modulate LED brightness with instantaneous CPU activity"
            echo "  on             - Turn blue LED on with steady solid illumination"
            echo "  off            - Turn blue LED off completely"
            echo "  set <trigger>  - Set an arbitrary kernel LED trigger"
            echo "  apply          - Reapply saved LED preferences from configuration file"
            echo ""
            echo "Options:"
            echo "  -q, --quiet    - Suppress informational messages"
            exit 1
            ;;
    esac
    return 0
}

CMD="${1:-status}"
case "$CMD" in
    -q|--quiet)
        CMD="${2:-status}"
        ;;
esac

case "$CMD" in
    status|get)
        show_status
        ;;
    heartbeat)
        set_led_mode "heartbeat"
        ;;
    disk|storage)
        set_led_mode "disk"
        ;;
    activity|cpu)
        set_led_mode "cpu"
        ;;
    on|solid)
        set_led_mode "on"
        ;;
    off)
        set_led_mode "off"
        ;;
    set)
        set_led_mode "custom" "$2"
        ;;
    apply)
        set_led_mode "apply"
        ;;
    *)
        set_led_mode "help"
        ;;
esac
