}

# 6. Storage & Partition Safety Menu
menu_storage() {
    while true; do
        print_dashboard_header
        echo -e "${C_YELLOW}${C_BOLD}[Storage & Partition Safety (vita-storage)]${C_RESET}"
        echo " 1) Set ux0: Read-Only  (ro - Safe mode; prevents filesystem corruption)"
        echo " 2) Set ux0: Read-Write (rw - Allows saving configs, downloads & packages)"
        echo " 3) View Storage Protection Status"
        echo " 4) Check Partition Free Space & Filesystem Utilization"
        echo " 5) Return to Main Menu"
        echo "================================================================================"
        printf " Select an option [1-5]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                /usr/bin/vita-storage ro ux0
                sleep 1
                ;;
            2)
                echo ""
                /usr/bin/vita-storage rw ux0
                sleep 1
                ;;
            3)
                echo ""
                /usr/bin/vita-storage status
                press_enter
                ;;
            4)
                echo ""
                echo "================================================================================"
                echo " Filesystem Disk Space Utilization:"
                echo "================================================================================"
                df -h /mnt/ux0 /mnt/ur0 /mnt/uma0 / 2>/dev/null || df -h
                echo "================================================================================"
                press_enter
                ;;
            5|"")
                return 0
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

# 7. Memory & Swapfile Menu
menu_memory() {
    while true; do
        print_dashboard_header
        echo -e "${C_YELLOW}${C_BOLD}[Memory & Compressed Swap Management (vita-swap)]${C_RESET}"
        echo " 1) View Memory & Swap Telemetry (RAM, ZRAM, swap utilization)"
        echo " 2) Enable ZRAM RAM Compression (256 MB compressed swap pool in RAM)"
        echo " 3) Disable ZRAM / Swap"
        echo " 4) Configure Swapfile on Storage (/mnt/ux0/swapfile)"
        echo " 5) Return to Main Menu"
        echo "================================================================================"
        printf " Select an option [1-5]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                echo "================================================================================"
                echo " System Memory Telemetry:"
                echo "================================================================================"
                free -m 2>/dev/null || free
                echo ""
                if command -v zramctl >/dev/null 2>&1; then
                    zramctl 2>/dev/null || true
                elif [ -f /sys/block/zram0/disksize ]; then
                    local zsize
                    zsize=$(cat /sys/block/zram0/disksize 2>/dev/null || echo 0)
                    echo "ZRAM0 Disksize: $(( zsize / 1048576 )) MB"
                fi
                echo "================================================================================"
                press_enter
                ;;
            2)
                echo ""
                if command -v vita-swap >/dev/null 2>&1; then
                    vita-swap on
                else
                    echo "[!] vita-swap utility not found."
                fi
                press_enter
                ;;
            3)
                echo ""
                if command -v vita-swap >/dev/null 2>&1; then
                    vita-swap off
                else
                    echo "[!] vita-swap utility not found."
                fi
                press_enter
                ;;
            4)
                echo ""
                if command -v vita-swap >/dev/null 2>&1; then
                    printf "Enter desired swapfile size in MB (e.g. 512): "
                    read -r sz_mb
                    if [ -n "$sz_mb" ]; then
                        vita-swap size "${sz_mb}M"
                    fi
                else
                    echo "[!] vita-swap utility not found."
                fi
                press_enter
                ;;
            5|"")
                return 0
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

# 8. Gamepad & Virtual Keyboard Menu
menu_input() {
    while true; do
        print_dashboard_header
        echo -e "${C_YELLOW}${C_BOLD}[Gamepad & Virtual Keyboard Controls]${C_RESET}"
        echo " 1) Toggle On-Screen Touch Keyboard (fbkeyboard)"
        echo " 2) View Gamepad Input Mapper Status (vita-input-mapper)"
        echo " 3) Physical Gamepad Shortcuts & Cheat Sheet"
        echo " 4) Return to Main Menu"
        echo "================================================================================"
        printf " Select an option [1-4]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                if command -v toggle-keyboard >/dev/null 2>&1; then
                    toggle-keyboard
                elif pidof fbkeyboard >/dev/null 2>&1; then
                    killall -SIGUSR1 fbkeyboard 2>/dev/null || true
                    echo "[OK] Keyboard toggled."
                else
                    echo "[!] fbkeyboard not found."
                fi
                sleep 1
                ;;
            2)
                echo ""
                if pidof vita-input-mapper >/dev/null 2>&1; then
                    echo "[OK] vita-input-mapper is ACTIVE (PID: $(pidof vita-input-mapper))."
                    echo "     Analog sticks and buttons are mapped to input events."
                else
                    echo "[i] vita-input-mapper is not currently running."
                fi
                press_enter
                ;;
            3)
                echo ""
                echo "================================================================================"
                echo " PlayStation Vita Physical Shortcuts Cheat Sheet:"
                echo "================================================================================"
                echo "  * SELECT Button       : Sends ESC key (exits vi, cancels command, dialogs)"
                echo "  * PS (PlayStation)    : Toggles fbkeyboard on-screen virtual keyboard"
                echo "  * VOLUME UP / DOWN    : Adjust screen brightness up/down by 10% (Vita 2000 LCD)"
                echo "  * POWER Button (tap)  : Immediate display sleep / wake"
                echo "  * POWER Button (hold) : Graceful system shutdown (hold 3s)"
                echo "  * Touchscreen         : Direct tap to click; bottom half types on fbkeyboard"
                echo "================================================================================"
                press_enter
                ;;
            4|"")
                return 0
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

# 9. Desktop & Boot Preferences Menu
menu_desktop() {
    while true; do
        print_dashboard_header
        echo -e "${C_YELLOW}${C_BOLD}[Desktop & Boot Preferences]${C_RESET}"
        echo " 1) Toggle Boot-to-Desktop (Directly launch IceWM on startup vs console)"
        echo " 2) Launch IceWM Graphical Desktop Now (alpine-desktop)"
        echo " 3) Run First-Boot Setup Wizard (vita-setup)"
        echo " 4) Run Hardware Diagnostics Suite (vita-diagnostics)"
        echo " 5) Return to Main Menu"
        echo "================================================================================"
        printf " Select an option [1-5]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                if command -v vita-autostart >/dev/null 2>&1; then
                    vita-autostart toggle
                else
                    echo "[!] vita-autostart utility not found."
                fi
                press_enter
                ;;
            2)
                echo ""
                echo "[*] Launching IceWM Graphical Desktop..."
                sleep 1
                if command -v alpine-desktop >/dev/null 2>&1; then
                    alpine-desktop
                else
                    echo "[!] alpine-desktop not found."
                    press_enter
                fi
                ;;
            3)
                echo ""
                if command -v vita-setup >/dev/null 2>&1; then
                    vita-setup
                else
                    echo "[!] vita-setup utility not found."
                    press_enter
                fi
                ;;
            4)
                echo ""
                if command -v vita-diagnostics >/dev/null 2>&1; then
                    vita-diagnostics
                else
                    echo "[!] vita-diagnostics utility not found."
                fi
                press_enter
                ;;
            5|"")
                return 0
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

# 10. System Reboot & Shutdown Menu
menu_power() {
    print_dashboard_header
    echo -e "${C_YELLOW}${C_BOLD}[System Power & Reset]${C_RESET}"
    echo " 1) Clean Reboot back to VitaOS LiveArea"
    echo " 2) Graceful System Power Off (Safe hardware shutdown)"
    echo " 3) Return to Main Menu"
    echo "================================================================================"
    printf " Select an option [1-3]: "
    read -r choice
    case "$choice" in
        1)
            echo ""
            echo "[*] Preparing clean reboot to VitaOS..."
            sync
            if command -v reboot >/dev/null 2>&1; then
                reboot
            else
                echo 1 > /proc/sys/kernel/sysrq
                echo b > /proc/sysrq-trigger
            fi
            ;;
        2)
            echo ""
            echo "[*] Shutting down LinuxOnVita..."
            sync
            if command -v poweroff >/dev/null 2>&1; then
                poweroff
            else
                echo 1 > /proc/sys/kernel/sysrq
                echo o > /proc/sysrq-trigger
            fi
            ;;
        3|"")
            return 0
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Main Menu
# ------------------------------------------------------------------------------

menu_main() {
    while true; do
        print_dashboard_header
        echo -e "${C_BOLD}Configuration Categories:${C_RESET}"
        echo "  1) Wireless & Networking       (Connect to Wi-Fi, scan, radio toggle, IP)"
        echo "  2) Bluetooth & Peripherals     (Pair keyboards, mice, gamepads, status)"
        echo "  3) Display & Screen Sleep      (Brightness on 2000 LCD, sleep daemon, dim)"
        echo "  4) CPU & Performance           (444 MHz max, 333 MHz standard, powersave)"
        echo "  5) LED Indicator Modes         (PS Button: Heartbeat, Disk, Solid, Off)"
        echo "  6) Storage & Partition Safety  (Read-only ux0 protection, remounts, space)"
        echo "  7) Memory & Compressed Swap    (ZRAM compressed RAM, swapfile allocation)"
        echo "  8) Gamepad & Virtual Keyboard  (Touch keyboard toggle, shortcuts cheat sheet)"
        echo "  9) Desktop & Boot Preferences  (Boot to IceWM toggle, setup wizard, logs)"
        echo " 10) System Reboot & Shutdown    (Reboot to VitaOS, Power off console)"
        echo " 11) Exit Control Center"
        echo "================================================================================"
        printf " Select a category [1-11]: "
        read -r choice
        case "$choice" in
            1) menu_wifi ;;
            2) menu_bluetooth ;;
            3) menu_display ;;
            4) menu_cpu ;;
            5) menu_led ;;
            6) menu_storage ;;
            7) menu_memory ;;
            8) menu_input ;;
            9) menu_desktop ;;
            10) menu_power ;;
            11|q|Q|exit)
                clear_screen
                echo "Exited PlayStation Vita Handheld Control Center."
                break
                ;;
            *)
                echo "Invalid option: $choice"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Direct CLI Dispatch & Non-Interactive Commands
# ------------------------------------------------------------------------------

show_help() {
    cat << EOF
Usage: vita-config [COMMAND] [ARGS...]
       config [COMMAND]

Handheld Control Center TUI for PlayStation Vita Linux.

Commands:
  (no args)             Launch interactive Handheld Control Center TUI
  status                Display system status dashboard and exit
  wifi [args...]        Jump to Wi-Fi settings or pass args to vita-wifi
  bluetooth [args...]   Jump to Bluetooth settings or pass args to vita-bluetooth
  webui [args...]       Manage web portal (vita-webui start/stop/status/url)
  display [level]       Adjust brightness (PS Vita 2000 LCD) or toggle display sleep
  cpu [profile|mhz]     Set CPU profile (max, balanced, powersave, 444, 333)
  storage [ro|rw]       Toggle storage protection mode on ux0
  led [mode]            Set PS Button LED mode (heartbeat, disk, on, off)
  swap [on|off]         Toggle ZRAM RAM compression
  autostart [on|off]    Toggle boot-to-desktop preference
  reboot                Clean reboot to VitaOS LiveArea
  poweroff              Graceful system shutdown
  help, -h, --help      Show this help message

Hardware Notes:
  * Display Brightness : Backlight adjustments are exclusive to PS Vita 2000 (Slim) LCD.
                         PS Vita 1000 OLED features fixed emissive hardware gamma.
  * Battery Telemetry  : Linux currently lacks a PMIC/fuel gauge driver; battery level
                         cannot be monitored in software.

Examples:
  vita-config               # Launch interactive menu
  vita-config status        # View system dashboard
  vita-config cpu max       # Immediately switch to 444 MHz
  vita-config display 75    # Set brightness to 75% (PS Vita 2000 LCD only)
  vita-config storage ro    # Lock storage into read-only protection
EOF
}

ACTION="${1:-}"
shift 2>/dev/null || true

case "$ACTION" in
    "")
        menu_main
        ;;
    status|info)
        print_dashboard_header
        echo ""
        ;;
    wifi|network)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-wifi "$@"
        else
            menu_wifi
        fi
        ;;
    bluetooth|bt)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-bluetooth "$@"
        else
            menu_bluetooth
        fi
        ;;
    webui|web)
        if command -v vita-webui >/dev/null 2>&1; then
            vita-webui "$@"
        else
            echo "[!] vita-webui utility not found."
        fi
        ;;
    display|brightness)
        hw=$(detect_hardware)
        if [ "$#" -gt 0 ]; then
            if [ "$1" = "sleep" ] || [ "$1" = "0" ]; then
                if command -v vita-powerd >/dev/null 2>&1; then
                    vita-powerd sleep
                else
                    /usr/bin/vita-brightness set 0
                fi
            elif [ "$1" = "wake" ]; then
                if command -v vita-powerd >/dev/null 2>&1; then
                    vita-powerd wake
                else
                    /usr/bin/vita-brightness max
                fi
            elif [ "$hw" = "oled" ]; then
                echo "Notice: PS Vita 1000 OLED displays do not use an adjustable LCD backlight."
                echo "Brightness is fixed at boot Level 15 Gamma. Display sleep is supported via:"
                echo "  vita-config display sleep"
            elif [ "$hw" = "pstv" ]; then
                echo "Notice: PlayStation TV uses HDMI output. Adjust display brightness on your monitor/TV."
            else
                /usr/bin/vita-brightness set "$1"
            fi
        else
            menu_display
        fi
        ;;
    cpu|performance)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-cpu "$@"
        else
            menu_cpu
        fi
        ;;
    led)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-led "$@"
        else
            menu_led
        fi
        ;;
    storage)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-storage "$@"
        else
            menu_storage
        fi
        ;;
    swap|memory)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-swap "$@"
        else
            menu_memory
        fi
        ;;
    autostart)
        if [ "$#" -gt 0 ]; then
            /usr/bin/vita-autostart "$@"
        else
            menu_desktop
        fi
        ;;
    input|keyboard)
        menu_input
        ;;
    desktop)
        menu_desktop
        ;;
    reboot)
        sync
        reboot
        ;;
    poweroff|shutdown)
        sync
        poweroff
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown option or category: '$ACTION'"
        echo "Run 'vita-config help' for usage details, or run without arguments for the TUI."
        exit 1
        ;;
esac
