#!/bin/sh
# vita-webui: PlayStation Vita Web Management Portal & Wireless File Transfer
# Controls the native vita-webui-server daemon on port 8080.
#
# Provides a handheld CLI and TUI for managing the web management portal:
#   - Check running status and active connection URL (http://<IP>:8080)
#   - Start, stop, and restart web server
#   - Toggle automatic startup at boot
#   - Configure custom listening port
#
# Licensed under the GNU General Public License v3.0 (GPL-3.0)

set -e
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

CONF_FILE="/etc/vita-webui.conf"
CONF_UX0="/mnt/ux0/linux/webui.conf"
BIN_SERVER="/usr/bin/vita-webui-server"
PID_FILE="/var/run/vita-webui.pid"
DEFAULT_PORT=8080
DEFAULT_DOCROOT="/mnt/ux0"

# ANSI Colors
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_CYAN="\033[1;36m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_RED="\033[1;31m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
fi

get_port() {
    if [ -f "$CONF_UX0" ]; then
        grep -E '^PORT=' "$CONF_UX0" 2>/dev/null | cut -d= -f2 || echo "$DEFAULT_PORT"
    elif [ -f "$CONF_FILE" ]; then
        grep -E '^PORT=' "$CONF_FILE" 2>/dev/null | cut -d= -f2 || echo "$DEFAULT_PORT"
    else
        echo "$DEFAULT_PORT"
    fi
}

is_autostart_enabled() {
    if [ -f "$CONF_UX0" ]; then
        grep -E -q '^AUTOSTART=1' "$CONF_UX0" 2>/dev/null && return 0
    fi
    if [ -f "$CONF_FILE" ]; then
        grep -E -q '^AUTOSTART=1' "$CONF_FILE" 2>/dev/null && return 0
    fi
    return 1
}

get_ip() {
    local ip=""
    ip=$(ip -4 addr show mlan0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || true)
    if [ -z "$ip" ]; then
        ip=$(ip -4 addr show wlan0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || true)
    fi
    if [ -z "$ip" ]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    fi
    echo "${ip:-127.0.0.1}"
}

is_running() {
    if pidof vita-webui-server >/dev/null 2>&1; then
        return 0
    fi
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

cmd_start() {
    local port="${1:-$(get_port)}"
    local docroot="$DEFAULT_DOCROOT"
    [ ! -d "$docroot" ] && docroot="/"

    if is_running; then
        echo -e "${C_YELLOW}[!] vita-webui is already running.${C_RESET}"
        cmd_status
        return 0
    fi

    if [ ! -x "$BIN_SERVER" ]; then
        echo -e "${C_RED}[!] Error: $BIN_SERVER binary not found.${C_RESET}"
        return 1
    fi

    echo -e "${C_CYAN}[*] Starting vita-webui on port ${port}...${C_RESET}"
    "$BIN_SERVER" -p "$port" -d "$docroot" -daemon

    # Record PID
    sleep 1
    local pid
    pid=$(pidof vita-webui-server 2>/dev/null | awk '{print $1}')
    if [ -n "$pid" ]; then
        echo "$pid" > "$PID_FILE" 2>/dev/null || true
        echo -e "${C_GREEN}[OK] Web management portal is active!${C_RESET}"
        cmd_status
    else
        echo -e "${C_RED}[!] Failed to start vita-webui-server.${C_RESET}"
        return 1
    fi
}

cmd_stop() {
    if ! is_running; then
        echo -e "${C_DIM}[i] vita-webui is not currently running.${C_RESET}"
        rm -f "$PID_FILE" 2>/dev/null || true
        return 0
    fi

    echo -e "${C_CYAN}[*] Stopping vita-webui...${C_RESET}"
    killall vita-webui-server 2>/dev/null || true
    sleep 1
    killall -9 vita-webui-server 2>/dev/null || true
    rm -f "$PID_FILE" 2>/dev/null || true
    echo -e "${C_GREEN}[OK] Web portal stopped.${C_RESET}"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start "$1"
}

cmd_enable() {
    mkdir -p /etc 2>/dev/null || true
    echo "AUTOSTART=1" > "$CONF_FILE"
    echo "PORT=$(get_port)" >> "$CONF_FILE"

    if [ -d "/mnt/ux0/linux" ]; then
        local was_ro=0
        if command -v vita-storage >/dev/null 2>&1 && vita-storage is-ro ux0 2>/dev/null; then
            vita-storage rw ux0 -q 2>/dev/null && was_ro=1
        fi
        echo "AUTOSTART=1" > "$CONF_UX0"
        echo "PORT=$(get_port)" >> "$CONF_UX0"
        sync
        [ "$was_ro" -eq 1 ] && vita-storage ro ux0 -q 2>/dev/null || true
    fi

    echo -e "${C_GREEN}[OK] vita-webui autostart ENABLED on boot.${C_RESET}"
}

cmd_disable() {
    if [ -f "$CONF_FILE" ]; then
        sed -i 's/^AUTOSTART=1/AUTOSTART=0/' "$CONF_FILE" 2>/dev/null || true
    fi

    if [ -f "$CONF_UX0" ]; then
        local was_ro=0
        if command -v vita-storage >/dev/null 2>&1 && vita-storage is-ro ux0 2>/dev/null; then
            vita-storage rw ux0 -q 2>/dev/null && was_ro=1
        fi
        sed -i 's/^AUTOSTART=1/AUTOSTART=0/' "$CONF_UX0" 2>/dev/null || true
        sync
        [ "$was_ro" -eq 1 ] && vita-storage ro ux0 -q 2>/dev/null || true
    fi

    echo -e "${C_YELLOW}[OK] vita-webui autostart DISABLED.${C_RESET}"
}

cmd_url() {
    local ip
    ip=$(get_ip)
    local port
    port=$(get_port)
    echo "http://${ip}:${port}"
}

cmd_status() {
    local port
    port=$(get_port)
    local ip
    ip=$(get_ip)
    local autostart="Disabled"
    is_autostart_enabled && autostart="Enabled (starts on boot)"

    echo "================================================================================"
    echo -e "${C_CYAN}${C_BOLD}PlayStation Vita - Web Management Portal (vita-webui)${C_RESET}"
    echo "================================================================================"

    if is_running; then
        local pid
        pid=$(pidof vita-webui-server 2>/dev/null || echo "Active")
        echo -e " Status     : ${C_GREEN}${C_BOLD}RUNNING${C_RESET} (PID: ${pid})"
        echo -e " URL        : ${C_BOLD}http://${ip}:${port}${C_RESET}"
        echo -e " mDNS URL   : ${C_BOLD}http://vita.local:${port}${C_RESET}"
        echo -e " Port       : ${port}"
        echo -e " Autostart  : ${autostart}"
        echo -e " Docroot    : ${DEFAULT_DOCROOT}"
        echo "--------------------------------------------------------------------------------"
        echo " Access the web portal from your phone, tablet, or PC browser to:"
        echo "   * Drag-and-drop file upload & download (ROMs, zips, wallpapers)"
        echo "   * Live system telemetry dashboard (CPU, RAM, ZRAM, storage)"
        echo "   * In-browser terminal command execution without SSH setup"
    else
        echo -e " Status     : ${C_DIM}STOPPED${C_RESET}"
        echo -e " Target URL : http://${ip}:${port}"
        echo -e " Autostart  : ${autostart}"
        echo "--------------------------------------------------------------------------------"
        echo " Run 'vita-webui start' to launch the web management portal."
    fi
    echo "================================================================================"
}

cmd_menu() {
    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        cmd_status
        echo ""
        echo " 1) Start Web Portal"
        echo " 2) Stop Web Portal"
        echo " 3) Restart Web Portal"
        echo " 4) Toggle Boot Autostart"
        echo " 5) Change Port (Current: $(get_port))"
        echo " 6) View URL"
        echo " 7) Exit"
        echo "--------------------------------------------------------------------------------"
        printf " Select an option [1-7]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                cmd_start
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            2)
                echo ""
                cmd_stop
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            3)
                echo ""
                cmd_restart
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            4)
                echo ""
                if is_autostart_enabled; then
                    cmd_disable
                else
                    cmd_enable
                fi
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            5)
                echo ""
                printf "Enter port number (e.g. 8080): "
                read -r new_port
                if echo "$new_port" | grep -q '^[0-9]\+$' && [ "$new_port" -ge 1 ] && [ "$new_port" -le 65535 ]; then
                    echo "PORT=$new_port" >> "$CONF_FILE"
                    echo "[OK] Port updated to $new_port. Restarting if active..."
                    if is_running; then
                        cmd_restart "$new_port"
                    fi
                else
                    echo "[!] Invalid port number."
                fi
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            6)
                echo ""
                echo -e "Portal URL: ${C_GREEN}$(cmd_url)${C_RESET}"
                echo -e "mDNS URL  : ${C_GREEN}http://vita.local:$(get_port)${C_RESET}"
                printf "Press [Enter] to continue..."
                read -r _
                ;;
            7|q|Q|exit|"")
                break
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

show_help() {
    cat << EOF
Usage: vita-webui [COMMAND] [ARGS...]

PlayStation Vita Web Management Portal & Wireless File Transfer.

Commands:
  (no args)       Open interactive handheld management menu
  status          Show web server status, PID, and active URLs
  start [port]    Start web server daemon in background (default port 8080)
  stop            Stop web server daemon
  restart [port]  Restart web server daemon
  enable, on      Enable automatic startup at system boot
  disable, off    Disable automatic startup at system boot
  url             Print only the browser access URL
  help, -h        Show this help message

Examples:
  vita-webui start        # Launch web portal on port 8080
  vita-webui status       # View connection URL and state
  vita-webui enable       # Start automatically whenever Wi-Fi connects
EOF
}

ACTION="${1:-}"
shift 2>/dev/null || true

case "$ACTION" in
    "")
        cmd_menu
        ;;
    status|info)
        cmd_status
        ;;
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart "$@"
        ;;
    enable|on)
        cmd_enable
        ;;
    disable|off)
        cmd_disable
        ;;
    url)
        cmd_url
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: '$ACTION'"
        echo "Run 'vita-webui help' for usage instructions."
        exit 1
        ;;
esac

