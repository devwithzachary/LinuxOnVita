#!/bin/sh
# vita-help: Built-In Software & Command Reference for PS Vita Linux
# Displays a comprehensive, categorized guide to all included tools and utilities.

# Setup terminal colors if connected to a TTY
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_GREEN="\033[0;32m"
    C_CYAN="\033[0;36m"
    C_YELLOW="\033[0;33m"
    C_BLUE="\033[0;34m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_GREEN=""
    C_CYAN=""
    C_YELLOW=""
    C_BLUE=""
fi

show_full_help() {
    echo "================================================================================"
    echo -e "${C_CYAN}${C_BOLD}PlayStation Vita Linux 6.12 - Built-In Software & Command Reference${C_RESET}"
    echo "================================================================================"
    echo ""
    echo -e "${C_BOLD}Setup & System Essentials:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-setup" "Interactive first-boot setup wizard (Wi-Fi, storage, swap, desktop)"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-diagnostics" "Hardware health check, kernel logs, and troubleshooting suite"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "reboot" "Clean system shutdown and hardware reset back to VitaOS"
    echo ""
    echo -e "${C_BOLD}Network & Wireless Connectivity:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-wifi" "Scan, connect, manage Wi-Fi networks and view signal telemetry"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-bluetooth" "Bluetooth manager for keyboards, mice, gamepads, and audio"
    echo -e "                     ${C_DIM}(Note: Marvell 88W8787 supports BT 2.1/3.0 Classic; BLE-only is unsupported)${C_RESET}"
    echo ""
    echo -e "${C_BOLD}Hardware, Power & Battery:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-cpu" "CPU clock scaling (111, 333, 444 MHz) and power profiles"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-brightness" "Screen brightness control (0-255 or presets 25%, 50%, 75%, 100%)"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-power" "Battery percentage, voltage, charging state, and life remaining"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-powerd" "Background power daemon (burn-in prevention, display timeout, sleep)"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-led" "PlayStation Button LED modes (heartbeat, disk, solid on, off)"
    echo ""
    echo -e "${C_BOLD}Desktop & System Environments:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "alpine-desktop" "Launch IceWM X11 graphical desktop with touch cursor navigation"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "alpine-chroot" "Isolated Alpine Linux container with 'apk' package manager"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-autostart" "Configure direct boot into desktop (on) or text console (off)"
    echo ""
    echo -e "${C_BOLD}Input, Gaming & Controls:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "fbkeyboard" "On-screen touch virtual keyboard for console framebuffer"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "toggle-keyboard" "Show or hide the touch virtual keyboard toggle"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-input-mapper" "Physical gamepad button and analog stick mapper for desktop"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-doom" "Play DOOM natively on Linux Framebuffer (/dev/fb0)"
    echo ""
    echo -e "${C_BOLD}Storage & Memory Expansion:${C_RESET}"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-storage" "Storage protection toggle (read-write 'rw' vs read-only 'ro')"
    printf "  ${C_GREEN}%-18s${C_RESET} %s\n" "vita-swap" "ZRAM compressed RAM expansion and swapfile manager"
    echo ""
    echo "================================================================================"
    echo -e "Detailed info: ${C_BOLD}help <command>${C_RESET} (e.g. ${C_CYAN}help vita-wifi${C_RESET} or ${C_CYAN}help wifi${C_RESET})"
    echo -e "Category info: ${C_BOLD}help <category>${C_RESET} (topics: ${C_CYAN}wifi, bluetooth, hardware, desktop, gaming, storage${C_RESET})"
    echo -e "Shell builtins: ${C_BOLD}builtin help <topic>${C_RESET} (e.g. ${C_CYAN}builtin help cd${C_RESET})"
    echo "================================================================================"
}

show_topic_help() {
    local topic="$1"
    case "$topic" in
        wifi|vita-wifi|network)
            if [ -x "/usr/bin/vita-wifi" ]; then
                /usr/bin/vita-wifi --help 2>/dev/null || /usr/bin/vita-wifi help
            else
                echo "vita-wifi: On-device Wi-Fi configuration and telemetry tool."
            fi
            ;;
        bluetooth|bt|vita-bluetooth)
            if [ -x "/usr/bin/vita-bluetooth" ]; then
                /usr/bin/vita-bluetooth --help 2>/dev/null || /usr/bin/vita-bluetooth help
            else
                echo "vita-bluetooth: Bluetooth peripheral pairing and audio manager."
            fi
            ;;
        cpu|vita-cpu)
            if [ -x "/usr/bin/vita-cpu" ]; then
                /usr/bin/vita-cpu --help
            else
                echo "vita-cpu: Dynamic CPU frequency scaling (111, 333, 444 MHz)."
            fi
            ;;
        brightness|vita-brightness)
            if [ -x "/usr/bin/vita-brightness" ]; then
                /usr/bin/vita-brightness --help
            else
                echo "vita-brightness: OLED and LCD screen brightness control (0-255)."
            fi
            ;;
        power|battery|vita-power)
            if [ -x "/usr/bin/vita-power" ]; then
                /usr/bin/vita-power --help 2>/dev/null || /usr/bin/vita-power
            else
                echo "vita-power: Battery level and hardware power status."
            fi
            ;;
        powerd|vita-powerd)
            if [ -x "/usr/bin/vita-powerd" ]; then
                /usr/bin/vita-powerd --help 2>/dev/null || echo "vita-powerd: Background power management daemon."
            fi
            ;;
        led|vita-led)
            if [ -x "/usr/bin/vita-led" ]; then
                /usr/bin/vita-led --help
            else
                echo "vita-led: PlayStation Button LED trigger control."
            fi
            ;;
        storage|vita-storage)
            if [ -x "/usr/bin/vita-storage" ]; then
                /usr/bin/vita-storage --help
            else
                echo "vita-storage: Toggle storage between read-write and read-only."
            fi
            ;;
        swap|memory|zram|vita-swap)
            if [ -x "/usr/bin/vita-swap" ]; then
                /usr/bin/vita-swap --help
            else
                echo "vita-swap: ZRAM memory expansion and swapfile management."
            fi
            ;;
        setup|vita-setup)
            if [ -x "/usr/bin/vita-setup" ]; then
                /usr/bin/vita-setup --help 2>/dev/null || echo "vita-setup: Interactive system setup wizard."
            fi
            ;;
        diagnostics|diag|vita-diagnostics|vita-diag)
            if [ -x "/usr/bin/vita-diagnostics" ]; then
                /usr/bin/vita-diagnostics --help
            else
                echo "vita-diagnostics: System health check and log gathering tool."
            fi
            ;;
        desktop|alpine-desktop|x11|icewm)
            echo "================================================================================"
            echo -e "${C_CYAN}${C_BOLD}IceWM Graphical Desktop Environment (alpine-desktop)${C_RESET}"
            echo "================================================================================"
            echo "Launch with: alpine-desktop"
            echo ""
            echo "Controls:"
            echo "  * Touchscreen: Tap to left-click, tap with two fingers for right-click"
            echo "  * Left Stick : Mouse cursor movement (when vita-input-mapper is running)"
            echo "  * Cross (X)  : Left mouse button"
            echo "  * Circle (O) : Right mouse button"
            echo "  * Square ([]) : Open on-screen virtual keyboard"
            echo "  * PS Button  : Release or toggle input mapper"
            echo "================================================================================"
            ;;
        chroot|alpine-chroot|apk)
            echo "================================================================================"
            echo -e "${C_CYAN}${C_BOLD}Alpine Linux Container Environment (alpine-chroot)${C_RESET}"
            echo "================================================================================"
            echo "Enter with: alpine-chroot"
            echo ""
            echo "Allows installing packages using the Alpine 'apk' package manager:"
            echo "  apk update"
            echo "  apk add python3 git curl tmux htop"
            echo ""
            echo "Type 'exit' to leave the chroot container and return to the main host system."
            echo "================================================================================"
            ;;
        doom|vita-doom|fbdoom)
            echo "================================================================================"
            echo -e "${C_CYAN}${C_BOLD}Native Framebuffer DOOM (vita-doom)${C_RESET}"
            echo "================================================================================"
            echo "Launch with: vita-doom"
            echo ""
            echo "Runs DOOM directly on the Linux framebuffer (/dev/fb0) at 60 FPS."
            echo "Controls:"
            echo "  * D-Pad / Left Stick: Movement"
            echo "  * Right Stick       : Turning"
            echo "  * Cross (X)         : Fire"
            echo "  * Circle (O)        : Open / Use doors and switches"
            echo "  * Triangle (^)      : Cycle weapon forward"
            echo "  * Square ([])       : Cycle weapon backward"
            echo "  * Start             : Pause / Menu"
            echo "================================================================================"
            ;;
        keyboard|fbkeyboard|toggle-keyboard)
            echo "================================================================================"
            echo -e "${C_CYAN}${C_BOLD}On-Screen Touch Virtual Keyboard (fbkeyboard)${C_RESET}"
            echo "================================================================================"
            echo "Toggle with: toggle-keyboard"
            echo ""
            echo "Renders a touch-enabled virtual keyboard on the bottom half of the display"
            echo "directly on the console framebuffer (/dev/fb0). Tap keys with your fingers"
            echo "to input shell commands without needing an external physical keyboard."
            echo "================================================================================"
            ;;
        hardware)
            echo "================================================================================"
            echo -e "${C_CYAN}${C_BOLD}PlayStation Vita - Hardware Control Commands${C_RESET}"
            echo "================================================================================"
            echo "  vita-brightness [0-255|25%|50%|75%|100%] : Set screen backlight brightness"
            echo "  vita-cpu [profile|mhz|status]            : Set CPU clock (111, 333, 444 MHz)"
            echo "  vita-power                               : Display battery level and telemetry"
            echo "  vita-led [heartbeat|disk|on|off]         : Control PlayStation Button blue LED"
            echo "  vita-powerd                              : Background power and burn-in daemon"
            echo "================================================================================"
            ;;
        *)
            if [ -x "/usr/bin/$topic" ]; then
                "/usr/bin/$topic" --help 2>/dev/null || "/usr/bin/$topic" -h 2>/dev/null || "/usr/bin/$topic"
            else
                echo "Unknown topic or command: $topic"
                echo "Run 'help' without arguments to see all available commands and categories."
            fi
            ;;
    esac
}

if [ "$#" -eq 0 ]; then
    show_full_help
else
    show_topic_help "$1"
fi

