#!/bin/sh
# vita-wifi: Interactive On-Device Wi-Fi Manager for PS Vita Linux
#
# Allows scanning, connecting, and switching wireless networks directly
# on the PS Vita console without rebooting or tethering to a PC.
#
# Commands:
#   vita-wifi scan                  - Scan and display available wireless networks
#   vita-wifi connect <SSID> [PASS] - Connect to a network and save credentials
#   vita-wifi status                - Show current Wi-Fi status and signal info
#   vita-wifi off                   - Turn off Wi-Fi radio to conserve battery
#   vita-wifi on                    - Turn on Wi-Fi radio and reconnect
#   vita-wifi (no args)             - Interactive menu mode

set -e
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# ANSI Colors (disabled if not a tty)
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_CYAN="\033[1;36m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_RED="\033[1;31m"
else
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
fi

get_iface() {
    # Check for mlan0 (PS Vita standard Marvell mwifiex driver)
    if [ -e "/sys/class/net/mlan0" ] || ip link show mlan0 >/dev/null 2>&1; then
        echo "mlan0"
        return 0
    fi
    # Check for wlan0
    if [ -e "/sys/class/net/wlan0" ] || ip link show wlan0 >/dev/null 2>&1; then
        echo "wlan0"
        return 0
    fi
    # Dynamic scan for any wireless interface
    for dev in /sys/class/net/*; do
        [ -e "$dev" ] || continue
        local name="${dev##*/}"
        [ "$name" = "lo" ] && continue
        if [ -e "$dev/phy80211" ] || [ -e "$dev/wireless" ]; then
            echo "$name"
            return 0
        fi
    done
    return 1
}

ensure_wpa_running() {
    local iface="$1"
    mkdir -p /var/run/wpa_supplicant

    ip link set "$iface" up 2>/dev/null || true

    if ! pidof wpa_supplicant >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Starting wpa_supplicant on $iface...${C_RESET}"
        local conf="/etc/wpa_supplicant.conf"
        for candidate in \
            /mnt/ux0/linux/wpa_supplicant.conf \
            /mnt/ur0/linux/wpa_supplicant.conf \
            /mnt/xmc0/linux/wpa_supplicant.conf \
            /mnt/uma0/linux/wpa_supplicant.conf; do
            if [ -f "$candidate" ]; then
                conf="$candidate"
                break
            fi
        done
        if [ ! -f "$conf" ]; then
            cat << 'EOF' > /etc/wpa_supplicant.conf
ctrl_interface=/var/run/wpa_supplicant
update_config=1
EOF
            conf="/etc/wpa_supplicant.conf"
        fi
        wpa_supplicant -B -i "$iface" -c "$conf" -O /var/run/wpa_supplicant
        sleep 1
    fi
}

cmd_scan() {
    local iface
    iface=$(get_iface) || {
        echo -e "${C_RED}Error: Wireless interface (mlan0/wlan0) not found.${C_RESET}"
        return 1
    }

    ensure_wpa_running "$iface"

    echo -e "${C_CYAN}Scanning for wireless networks on $iface...${C_RESET}"
    wpa_cli -i "$iface" scan >/dev/null 2>&1 || true

    sleep 2

    local raw
    raw=$(wpa_cli -i "$iface" scan_results 2>/dev/null || true)
    if [ -z "$raw" ]; then
        sleep 1
        raw=$(wpa_cli -i "$iface" scan_results 2>/dev/null || true)
    fi

    local scan_cache="/tmp/vita_wifi_scan.list"
    rm -f "$scan_cache"

    echo "$raw" | awk -F'\t' -v cache="$scan_cache" '
    NR>1 && $1 ~ /^[0-9a-fA-F:]+$/ {
        bssid=$1; freq=$2; signal=$3+0; flags=$4; ssid=$5;
        if (ssid == "" || ssid ~ /^[ \t]*$/) next;

        # Keep strongest signal per unique SSID
        if (!(ssid in seen)) {
            seen[ssid] = 1;
            best_order[++n] = ssid;
            max_sig[ssid] = signal;
            best_bssid[ssid] = bssid;
            best_flags[ssid] = flags;
        } else if (signal > max_sig[ssid]) {
            max_sig[ssid] = signal;
            best_bssid[ssid] = bssid;
            best_flags[ssid] = flags;
        }
    }
    END {
        print "+----+--------------------------+--------+----------+-------------------+"
        print "| #  | SSID                     | SIGNAL | SECURITY | BSSID             |"
        print "+----+--------------------------+--------+----------+-------------------+"
        if (n == 0) {
            print "|    | No wireless networks found. Try scanning again.                  |"
            print "+----+--------------------------+--------+----------+-------------------+"
            return
        }
        for (i = 1; i <= n; i++) {
            s = best_order[i];
            sig = max_sig[s];
            fl = best_flags[s];
            bs = best_bssid[s];

            if (sig >= -55) bars = "[====]"
            else if (sig >= -68) bars = "[=== ]"
            else if (sig >= -80) bars = "[==  ]"
            else bars = "[=   ]"

            if (fl ~ /WPA3/) sec = "WPA3"
            else if (fl ~ /WPA2/ && fl ~ /WPA/) sec = "WPA/WPA2"
            else if (fl ~ /WPA2/) sec = "WPA2"
            else if (fl ~ /WPA/) sec = "WPA"
            else if (fl ~ /WEP/) sec = "WEP"
            else sec = "Open"

            if (length(s) > 24) disp_ssid = substr(s, 1, 21) "..."
            else disp_ssid = s

            printf "| %-2d | %-24s | %-6s | %-8s | %-17s |\n", i, disp_ssid, bars, sec, bs
            print s >> cache
        }
        print "+----+--------------------------+--------+----------+-------------------+"
    }'

    if [ -s "$scan_cache" ]; then
        local total
        total=$(wc -l < "$scan_cache" | tr -d ' ')
        echo ""
        printf "${C_BOLD}Connect to a network from this list? [1-%s] (or Enter to skip): ${C_RESET}" "$total"
        local sel
        read -r sel
        if [ -n "$sel" ] && [ "$sel" -eq "$sel" ] 2>/dev/null && [ "$sel" -ge 1 ] && [ "$sel" -le "$total" ]; then
            local target_ssid
            target_ssid=$(sed -n "${sel}p" "$scan_cache")
            if [ -n "$target_ssid" ]; then
                echo ""
                cmd_connect "$target_ssid"
            fi
        fi
    fi
}

cmd_connect() {
    local target_ssid="$1"
    local target_psk="$2"
    local iface
    iface=$(get_iface) || {
        echo -e "${C_RED}Error: Wireless interface (mlan0/wlan0) not found.${C_RESET}"
        return 1
    }

    if [ -z "$target_ssid" ]; then
        printf "${C_BOLD}Enter Wi-Fi Network Name (SSID): ${C_RESET}"
        read -r target_ssid
    fi

    if [ -z "$target_ssid" ]; then
        echo -e "${C_RED}Error: SSID cannot be empty.${C_RESET}"
        return 1
    fi

    if [ -z "$target_psk" ]; then
        printf "${C_BOLD}Enter Passphrase for '%s' (leave blank for Open network): ${C_RESET}" "$target_ssid"
        if [ -t 0 ]; then
            stty -echo 2>/dev/null || true
            read -r target_psk
            stty echo 2>/dev/null || true
            echo ""
        else
            read -r target_psk
        fi
    fi

    if [ -n "$target_psk" ] && [ ${#target_psk} -lt 8 ]; then
        echo -e "${C_RED}Error: WPA/WPA2 passphrase must be at least 8 characters.${C_RESET}"
        return 1
    fi

    echo -e "${C_CYAN}Configuring connection to '${target_ssid}'...${C_RESET}"

    local tmp_conf="/tmp/wpa_supplicant.conf.new"
    cat << EOF > "$tmp_conf"
ctrl_interface=/var/run/wpa_supplicant
update_config=1

EOF

    if [ -n "$target_psk" ]; then
        cat << EOF >> "$tmp_conf"
network={
    ssid="${target_ssid}"
    psk="${target_psk}"
    key_mgmt=WPA-PSK
}
EOF
    else
        cat << EOF >> "$tmp_conf"
network={
    ssid="${target_ssid}"
    key_mgmt=NONE
}
EOF
    fi

    # Save to /etc/wpa_supplicant.conf (RAM)
    cp "$tmp_conf" /etc/wpa_supplicant.conf

    # Save to persistent storage (ux0, ur0, uma0, xmc0)
    local saved_path=""
    for m in /mnt/ux0 /mnt/ur0 /mnt/uma0 /mnt/xmc0; do
        if grep -qs " $m " /proc/mounts || [ -d "$m" ]; then
            local m_name=$(basename "$m")
            local ro_elevated=0

            # Elevate storage to read-write if currently read-only
            if command -v vita-storage >/dev/null 2>&1; then
                if vita-storage is-ro "$m_name" 2>/dev/null; then
                    vita-storage rw "$m_name" -q 2>/dev/null && ro_elevated=1
                fi
            elif grep -E -q " $m [^ ]+ (ro|.*,ro)( |$|,)" /proc/mounts 2>/dev/null; then
                mount -o remount,rw "$m" 2>/dev/null && ro_elevated=1
            fi

            mkdir -p "$m/linux" 2>/dev/null
            if cp "$tmp_conf" "$m/linux/wpa_supplicant.conf" 2>/dev/null; then
                sync
                saved_path="$m/linux/wpa_supplicant.conf"
            fi

            # Safely restore read-only protection
            if [ $ro_elevated -eq 1 ]; then
                if command -v vita-storage >/dev/null 2>&1; then
                    vita-storage ro "$m_name" -q 2>/dev/null || true
                else
                    mount -o remount,ro "$m" 2>/dev/null || true
                fi
            fi

            [ -n "$saved_path" ] && break
        fi
    done
    rm -f "$tmp_conf"

    if [ -n "$saved_path" ]; then
        echo -e "${C_GREEN}[OK] Saved persistent configuration to: $saved_path${C_RESET}"
        echo -e "${C_GREEN}     (Storage safely restored to read-only protection)${C_RESET}"
    else
        echo -e "${C_YELLOW}[!] Persistent storage not writable. Config saved to /etc/wpa_supplicant.conf (RAM only).${C_RESET}"
    fi

    echo -e "${C_CYAN}Restarting wireless service on $iface...${C_RESET}"
    killall udhcpc 2>/dev/null || true
    killall wpa_supplicant 2>/dev/null || true
    sleep 1

    mkdir -p /var/run/wpa_supplicant
    ip link set "$iface" up 2>/dev/null || true

    wpa_supplicant -B -i "$iface" -c /etc/wpa_supplicant.conf -O /var/run/wpa_supplicant

    echo -n "Associating with '${target_ssid}'"
    local associated=0
    for _ in $(seq 1 15); do
        local state
        state=$(wpa_cli -i "$iface" status 2>/dev/null | grep "^wpa_state=" | cut -d= -f2 || true)
        if [ "$state" = "COMPLETED" ]; then
            associated=1
            break
        fi
        printf "."
        sleep 1
    done
    echo ""

    if [ $associated -eq 1 ]; then
        echo -e "${C_GREEN}[OK] Successfully associated with '${target_ssid}'!${C_RESET}"
        echo "Requesting IP address via DHCP..."
        udhcpc -i "$iface" -b -R 2>/dev/null || true

        local ip=""
        for _ in $(seq 1 15); do
            ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2 || true)
            [ -n "$ip" ] && break
            sleep 1
        done

        if [ -n "$ip" ]; then
            echo ""
            echo "=================================================="
            echo -e "${C_GREEN}${C_BOLD}  Wi-Fi Connected Successfully!${C_RESET}"
            echo -e "  Network:     ${C_CYAN}${target_ssid}${C_RESET}"
            echo -e "  IP Address:  ${C_GREEN}${ip}${C_RESET}"
            echo -e "  SSH Ready:   ${C_BOLD}ssh root@${ip}${C_RESET}"
            if ! pidof sshd >/dev/null 2>&1; then
                if [ -x /etc/init.d/S50sshd ]; then
                    /etc/init.d/S50sshd start >/dev/null 2>&1 || true
                elif [ -x /usr/sbin/sshd ]; then
                    /usr/sbin/sshd 2>/dev/null || true
                fi
            fi
            return 0
        else
            echo -e "${C_YELLOW}[!] Associated with '${target_ssid}', waiting for DHCP lease in background.${C_RESET}"
            echo "Run 'vita-wifi status' in a few seconds to check IP."
            return 0
        fi
    else
        echo -e "${C_RED}[FAIL] Could not associate with '${target_ssid}'.${C_RESET}"
        echo "Please verify your passphrase and ensure the router is in range."
        return 1
    fi
}

cmd_status() {
    local iface
    iface=$(get_iface) || {
        echo -e "${C_RED}Error: Wireless interface (mlan0/wlan0) not found.${C_RESET}"
        return 1
    }

    local operstate="DOWN"
    [ -f "/sys/class/net/$iface/operstate" ] && operstate=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "UNKNOWN")

    local mac=""
    [ -f "/sys/class/net/$iface/address" ] && mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null)

    local ip=""
    ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2 || true)

    local wpa_out=""
    if pidof wpa_supplicant >/dev/null 2>&1; then
        wpa_out=$(wpa_cli -i "$iface" status 2>/dev/null || true)
    fi

    local ssid=""
    local bssid=""
    local wpa_state="DISCONNECTED"

    if [ -n "$wpa_out" ]; then
        ssid=$(echo "$wpa_out" | grep "^ssid=" | cut -d= -f2- || true)
        bssid=$(echo "$wpa_out" | grep "^bssid=" | cut -d= -f2- || true)
        wpa_state=$(echo "$wpa_out" | grep "^wpa_state=" | cut -d= -f2- || true)
    elif ! pidof wpa_supplicant >/dev/null 2>&1; then
        wpa_state="STOPPED (wpa_supplicant not running)"
    fi

    local rssi=""
    local signal_str="N/A"
    local sig_poll=""
    if pidof wpa_supplicant >/dev/null 2>&1; then
        sig_poll=$(wpa_cli -i "$iface" signal_poll 2>/dev/null || true)
        if [ -n "$sig_poll" ]; then
            rssi=$(echo "$sig_poll" | grep "^RSSI=" | cut -d= -f2 || true)
        fi
    fi

    if [ -n "$rssi" ]; then
        local sig_num=$((rssi + 0))
        if [ "$sig_num" -ge -55 ]; then
            signal_str="[====] ${rssi} dBm (Excellent)"
        elif [ "$sig_num" -ge -68 ]; then
            signal_str="[=== ] ${rssi} dBm (Good)"
        elif [ "$sig_num" -ge -80 ]; then
            signal_str="[==  ] ${rssi} dBm (Fair)"
        else
            signal_str="[=   ] ${rssi} dBm (Weak)"
        fi
    fi

    echo "=================================================="
    echo -e "${C_CYAN}${C_BOLD} PlayStation Vita Wi-Fi Status${C_RESET}"
    echo "=================================================="
    echo " Interface:   $iface ($operstate)"
    echo " Radio State: $wpa_state"
    if [ -n "$ssid" ]; then
        echo -e " SSID:        ${C_GREEN}${ssid}${C_RESET}"
        echo " BSSID:       ${bssid:-N/A}"
        echo " Signal:      $signal_str"
    else
        echo " SSID:        (Not connected)"
    fi
    echo " IP Address:  ${ip:-None (Not assigned)}"
    echo " MAC Address: ${mac:-Unknown}"
    if [ -n "$ip" ]; then
        echo -e " SSH Ready:   ${C_BOLD}ssh root@${ip}${C_RESET}"
    fi
    echo "=================================================="
}

cmd_off() {
    local iface
    iface=$(get_iface) || true
    echo -e "${C_YELLOW}Powering off Wi-Fi...${C_RESET}"
    touch /tmp/wifi_disabled 2>/dev/null || true
    if command -v vita-wifi-daemon >/dev/null 2>&1; then
        vita-wifi-daemon stop >/dev/null 2>&1 || true
    fi
    killall udhcpc 2>/dev/null || true
    killall wpa_supplicant 2>/dev/null || true
    if [ -n "$iface" ]; then
        ip link set "$iface" down 2>/dev/null || true
    fi
    rfkill block wifi 2>/dev/null || true
    echo -e "${C_GREEN}[OK] Wi-Fi disabled to conserve battery.${C_RESET}"
}

cmd_on() {
    local iface
    iface=$(get_iface) || true
    echo -e "${C_CYAN}Powering on Wi-Fi radio...${C_RESET}"
    rm -f /tmp/wifi_disabled 2>/dev/null || true
    rfkill unblock wifi 2>/dev/null || true
    if [ -n "$iface" ]; then
        ip link set "$iface" up 2>/dev/null || true
    fi
    /etc/init.d/S45wifi start
    if command -v vita-wifi-daemon >/dev/null 2>&1; then
        vita-wifi-daemon start >/dev/null 2>&1 || true
    fi
    echo -e "${C_GREEN}[OK] Wi-Fi service started.${C_RESET}"
    echo "Run 'vita-wifi status' in a few seconds to verify connection."
}

cmd_disconnect() {
    local iface
    iface=$(get_iface) || true
    echo -e "${C_YELLOW}Disconnecting from Wi-Fi network...${C_RESET}"
    if [ -n "$iface" ]; then
        wpa_cli -i "$iface" disconnect >/dev/null 2>&1 || true
        killall udhcpc 2>/dev/null || true
        ip addr flush dev "$iface" 2>/dev/null || true
    fi
    echo -e "${C_GREEN}[OK] Disconnected from Wi-Fi.${C_RESET}"
}

cmd_toggle() {
    local iface
    iface=$(get_iface) || true
    local operstate="DOWN"
    [ -f "/sys/class/net/$iface/operstate" ] && operstate=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "DOWN")
    if [ -f "/tmp/wifi_disabled" ] || [ "$operstate" = "DOWN" ]; then
        cmd_on
    else
        cmd_off
    fi
}

cmd_status_gui() {
    if [ -n "$DISPLAY" ] && command -v yad >/dev/null 2>&1; then
        local status_text
        status_text=$(cmd_status | sed 's/\x1b\[[0-9;]*m//g')
        yad --title="PlayStation Vita Wi-Fi Telemetry" \
            --window-icon="network-wireless" \
            --width=460 --height=320 --center \
            --text-info --fontname="Monospace 9" \
            <<< "$status_text" \
            --button="OK:0"
    else
        cmd_status
    fi
}

cmd_gui() {
    if [ -z "$DISPLAY" ] || ! command -v yad >/dev/null 2>&1; then
        cmd_menu
        return $?
    fi

    local iface
    iface=$(get_iface) || true
    if [ -z "$iface" ]; then
        yad --error --title="Wi-Fi Interface Missing" \
            --window-icon="network-wireless" \
            --width=380 --center \
            --text="<b>No Wireless Interface Found</b>\n\nThe Marvell 88W8787 wireless driver (mlan0) is not loaded or the interface is missing." \
            --button="OK:0"
        return 1
    fi

    ensure_wpa_running "$iface"

    while true; do
        local cur_ssid="" cur_ip="" cur_rssi="" cur_bssid="" operstate="DOWN"
        [ -f "/sys/class/net/$iface/operstate" ] && operstate=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "DOWN")
        cur_ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2 || true)

        local wpa_out=""
        if pidof wpa_supplicant >/dev/null 2>&1; then
            wpa_out=$(wpa_cli -i "$iface" status 2>/dev/null || true)
            cur_ssid=$(echo "$wpa_out" | grep "^ssid=" | cut -d= -f2- || true)
            cur_bssid=$(echo "$wpa_out" | grep "^bssid=" | cut -d= -f2- || true)
        fi

        local sig_poll=""
        if pidof wpa_supplicant >/dev/null 2>&1; then
            sig_poll=$(wpa_cli -i "$iface" signal_poll 2>/dev/null || true)
            cur_rssi=$(echo "$sig_poll" | grep "^RSSI=" | cut -d= -f2 || true)
        fi

        local status_markup=""
        if [ -n "$cur_ssid" ] && [ -n "$cur_ip" ]; then
            local sig_text=""
            if [ -n "$cur_rssi" ]; then
                local pct=$(( (cur_rssi + 100) * 2 ))
                [ $pct -gt 100 ] && pct=100
                [ $pct -lt 0 ] && pct=0
                sig_text=" | Signal: <b>${pct}%</b> (${cur_rssi} dBm)"
            fi
            status_markup="Connected to <b><span color='#00bb00'>${cur_ssid}</span></b>\nIP Address: <b>${cur_ip}</b>${sig_text}"
        elif [ -n "$cur_ssid" ]; then
            status_markup="Associated with <b><span color='#ffaa00'>${cur_ssid}</span></b> (Waiting for IP...)"
        elif [ -f "/tmp/wifi_disabled" ]; then
            status_markup="<span color='#cc0000'>Wi-Fi Radio Power OFF</span> (Disabled)"
        else
            status_markup="<span color='#888888'>Disconnected / Idle</span> (Select a network below to connect)"
        fi

        wpa_cli -i "$iface" scan >/dev/null 2>&1 || true
        local raw=""
        raw=$(wpa_cli -i "$iface" scan_results 2>/dev/null || true)

        local rows=()
        local count=0

        if [ -n "$raw" ]; then
            local parsed
            parsed=$(echo "$raw" | awk -F'\t' -v active="$cur_ssid" '
            NR>1 && $1 ~ /^[0-9a-fA-F:]+$/ {
                bssid=$1; freq=$2; signal=$3+0; flags=$4; ssid=$5;
                if (ssid == "" || ssid ~ /^[ \t]*$/) next;

                if (!(ssid in seen)) {
                    seen[ssid] = 1;
                    best_order[++n] = ssid;
                    max_sig[ssid] = signal;
                    best_bssid[ssid] = bssid;
                    best_flags[ssid] = flags;
                } else if (signal > max_sig[ssid]) {
                    max_sig[ssid] = signal;
                    best_bssid[ssid] = bssid;
                    best_flags[ssid] = flags;
                }
            }
            END {
                for (i = 1; i <= n; i++) {
                    s = best_order[i];
                    sig = max_sig[s];
                    fl = best_flags[s];
                    bs = best_bssid[s];

                    pct = (sig + 100) * 2;
                    if (pct > 100) pct = 100;
                    if (pct < 0) pct = 0;

                    if (sig >= -55) bars = "[====]";
                    else if (sig >= -68) bars = "[=== ]";
                    else if (sig >= -80) bars = "[==  ]";
                    else bars = "[=   ]";

                    sig_str = sprintf("%s %d%% (%d dBm)", bars, pct, sig);

                    if (fl ~ /WPA3/) sec = "WPA3";
                    else if (fl ~ /WPA2/ && fl ~ /WPA/) sec = "WPA/WPA2";
                    else if (fl ~ /WPA2/) sec = "WPA2";
                    else if (fl ~ /WPA/) sec = "WPA";
                    else if (fl ~ /WEP/) sec = "WEP";
                    else sec = "Open";

                    sel = (s == active) ? "TRUE" : "FALSE";
                    printf "%s\t%s\t%s\t%s\t%s\n", sel, s, sig_str, sec, bs;
                }
            }')

            while IFS="$(printf '\t')" read -r r_sel r_ssid r_sig r_sec r_bssid; do
                [ -z "$r_ssid" ] && continue
                rows+=("$r_sel" "$r_ssid" "$r_sig" "$r_sec" "$r_bssid")
                count=$((count + 1))
            done << EOF
$parsed
EOF
        fi

        if [ $count -eq 0 ]; then
            rows+=("FALSE" "(No networks found - click Rescan)" "[    ] 0%" "None" "00:00:00:00:00:00")
        fi

        local choice
        choice=$(yad --title="PlayStation Vita Wi-Fi Manager" \
                     --window-icon="network-wireless" \
                     --width=540 --height=400 --center \
                     --text="<b>PlayStation Vita Wireless Network Manager</b>\n${status_markup}" \
                     --list --radiolist \
                     --column="Select" --column="SSID" --column="Signal" --column="Security" --column="BSSID" \
                     "${rows[@]}" \
                     --button="Connect:0" \
                     --button="Rescan:2" \
                     --button="Disconnect:3" \
                     --button="Manual SSID:4" \
                     --button="Radio ON/OFF:5" \
                     --button="Close:1")
        local exit_code=$?

        case "$exit_code" in
            0)
                local sel_ssid
                sel_ssid=$(echo "$choice" | awk -F'|' '{print $2}')
                local sel_sec
                sel_sec=$(echo "$choice" | awk -F'|' '{print $4}')

                if [ -z "$sel_ssid" ] || [ "$sel_ssid" = "(No networks found - click Rescan)" ]; then
                    continue
                fi

                local pass=""
                if [ "$sel_sec" != "Open" ] && [ "$sel_sec" != "None" ]; then
                    pass=$(yad --title="Wi-Fi Security Passphrase" \
                               --window-icon="network-wireless" \
                               --width=380 --center \
                               --text="Enter WPA passphrase for <b>${sel_ssid}</b>:\n<small>(Minimum 8 characters)</small>" \
                               --entry --hide-text \
                               --button="Connect:0" --button="Cancel:1")
                    [ $? -ne 0 ] && continue
                    if [ -n "$pass" ] && [ ${#pass} -lt 8 ]; then
                        yad --warning --title="Invalid Passphrase" \
                            --window-icon="network-wireless" \
                            --width=320 --center \
                            --text="WPA passphrases must be at least 8 characters." \
                            --button="OK:0"
                        continue
                    fi
                fi

                cmd_connect "$sel_ssid" "$pass" | yad --progress --pulsate \
                    --title="Connecting to Wi-Fi" \
                    --window-icon="network-wireless" \
                    --width=380 --center \
                    --text="Associating with <b>${sel_ssid}</b> and requesting IP address..." \
                    --auto-close --no-buttons

                local new_ip=""
                new_ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2 || true)
                if [ -n "$new_ip" ]; then
                    yad --info --title="Wi-Fi Connected" \
                        --window-icon="network-wireless" \
                        --width=380 --center \
                        --text="<b>Successfully connected to ${sel_ssid}!</b>\n\nIP Address: <b>${new_ip}</b>\nSSH Access: <code>ssh root@${new_ip}</code>" \
                        --button="OK:0"
                else
                    yad --error --title="Connection Incomplete" \
                        --window-icon="network-wireless" \
                        --width=380 --center \
                        --text="Could not complete connection to <b>${sel_ssid}</b>.\nPlease verify your passphrase and signal range." \
                        --button="OK:0"
                fi
                ;;
            2)
                (
                    wpa_cli -i "$iface" scan >/dev/null 2>&1 || true
                    sleep 2
                ) | yad --progress --pulsate \
                        --title="Scanning Wi-Fi" \
                        --window-icon="network-wireless" \
                        --width=340 --center \
                        --text="Scanning for nearby 2.4 GHz wireless networks..." \
                        --auto-close --no-buttons
                ;;
            3)
                cmd_disconnect
                yad --info --title="Disconnected" \
                    --window-icon="network-wireless" \
                    --width=320 --center \
                    --text="Disconnected from Wi-Fi network." \
                    --button="OK:0"
                ;;
            4)
                local form_out
                form_out=$(yad --title="Connect to Hidden / Manual Network" \
                               --window-icon="network-wireless" \
                               --width=380 --center \
                               --text="Enter Wi-Fi network credentials:" \
                               --form \
                               --field="Network SSID:" "" \
                               --field="Passphrase (leave blank for Open):":H "" \
                               --button="Connect:0" --button="Cancel:1")
                [ $? -ne 0 ] && continue

                local man_ssid man_pass
                man_ssid=$(echo "$form_out" | awk -F'|' '{print $1}')
                man_pass=$(echo "$form_out" | awk -F'|' '{print $2}')

                if [ -n "$man_ssid" ]; then
                    cmd_connect "$man_ssid" "$man_pass" | yad --progress --pulsate \
                        --title="Connecting" \
                        --window-icon="network-wireless" \
                        --width=380 --center \
                        --text="Associating with <b>${man_ssid}</b>..." \
                        --auto-close --no-buttons
                fi
                ;;
            5)
                cmd_toggle
                ;;
            *)
                break
                ;;
        esac
    done
}

cmd_menu() {
    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        echo "=================================================="
        echo -e "${C_CYAN}${C_BOLD} PlayStation Vita Wi-Fi Manager (vita-wifi)${C_RESET}"
        echo "=================================================="
        local iface
        iface=$(get_iface) || true
        local cur_ssid=""
        local cur_ip=""
        if [ -n "$iface" ]; then
            cur_ssid=$(wpa_cli -i "$iface" status 2>/dev/null | grep "^ssid=" | cut -d= -f2- || true)
            cur_ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2 || true)
        fi

        if [ -n "$cur_ssid" ] && [ -n "$cur_ip" ]; then
            echo -e " Status: ${C_GREEN}Connected to '${cur_ssid}' (${cur_ip})${C_RESET}"
        elif [ -n "$cur_ssid" ]; then
            echo -e " Status: ${C_YELLOW}Connected to '${cur_ssid}' (Waiting for IP...)${C_RESET}"
        elif [ -f "/tmp/wifi_disabled" ]; then
            echo -e " Status: ${C_RED}Wi-Fi Radio Power OFF${C_RESET}"
        else
            echo " Status: Disconnected / Radio Idle"
        fi
        echo "--------------------------------------------------"
        echo " 1) Scan for wireless networks"
        echo " 2) Connect to a network"
        echo " 3) View detailed status"
        echo " 4) Disconnect active network"
        echo " 5) Turn Wi-Fi OFF (save battery)"
        echo " 6) Turn Wi-Fi ON / Reconnect"
        echo " 7) Exit"
        echo "=================================================="
        printf " Select an option [1-7]: "
        read -r choice
        case "$choice" in
            1)
                echo ""
                cmd_scan
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            2)
                echo ""
                cmd_connect "" ""
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            3)
                echo ""
                cmd_status
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            4)
                echo ""
                cmd_disconnect
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            5)
                echo ""
                cmd_off
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            6)
                echo ""
                cmd_on
                echo ""
                printf "Press Enter to return to menu..."
                read -r _
                ;;
            7|q|Q)
                echo "Exiting."
                break
                ;;
            *)
                echo "Invalid option."
                sleep 1
                ;;
        esac
    done
}

ACTION="${1:-}"
shift 2>/dev/null || true

case "$ACTION" in
    scan)
        cmd_scan
        ;;
    scan-gui)
        cmd_gui
        ;;
    connect)
        cmd_connect "${1:-}" "${2:-}"
        ;;
    disconnect)
        cmd_disconnect
        ;;
    status)
        cmd_status
        ;;
    status-gui)
        cmd_status_gui
        ;;
    off|disable|stop)
        cmd_off
        ;;
    on|enable|start)
        cmd_on
        ;;
    toggle)
        cmd_toggle
        ;;
    daemon)
        /usr/bin/vita-wifi-daemon "$@"
        ;;
    gui)
        cmd_gui
        ;;
    help|-h|--help)
        echo "PlayStation Vita Wi-Fi Manager (vita-wifi)"
        echo ""
        echo "Usage: vita-wifi [command]"
        echo ""
        echo "Commands:"
        echo "  scan                   Scan and display available Wi-Fi networks"
        echo "  connect <SSID> [PASS]  Connect to network and save configuration"
        echo "  disconnect             Disconnect from current wireless network"
        echo "  status                 Display current connection and signal details"
        echo "  status-gui             Display graphical signal telemetry dialog"
        echo "  off                    Turn Wi-Fi off to conserve battery"
        echo "  on                     Turn Wi-Fi on and reconnect"
        echo "  toggle                 Toggle Wi-Fi radio power ON / OFF"
        echo "  daemon [start|stop]    Manage background reconnection daemon"
        echo "  gui                    Open graphical touch manager (X11 desktop)"
        echo "  (no args)              Interactive menu mode"
        ;;
    *)
        if [ -n "$DISPLAY" ] && [ "$ACTION" = "gui" ]; then
            cmd_gui
        elif [ -n "$DISPLAY" ] && command -v yad >/dev/null 2>&1 && [ -z "$ACTION" ]; then
            cmd_gui
        else
            cmd_menu
        fi
        ;;
esac
