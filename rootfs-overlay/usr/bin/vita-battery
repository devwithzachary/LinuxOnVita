#!/bin/sh
# vita-battery: Battery status reporter for PS Vita Linux

PERCENT=""
CHARGING=""
VOLTAGE=""

# 1. Check bootloader hardware battery status files
BATT_FILES="
/mnt/ux0/linux/battery.txt
/mnt/ur0/linux/battery.txt
/mnt/ux0/battery.txt
/mnt/ur0/battery.txt
/var/run/vita_battery.txt
"

for f in $BATT_FILES; do
    if [ -f "$f" ]; then
        . "$f" 2>/dev/null
        if [ -n "$PERCENT" ]; then
            break
        fi
    fi
done

# 2. Check /sys/class/power_supply if registered
if [ -z "$PERCENT" ]; then
    for ps in /sys/class/power_supply/*; do
        if [ -d "$ps" ]; then
            if [ -f "$ps/capacity" ]; then
                PERCENT=$(cat "$ps/capacity")
            fi
            if [ -f "$ps/status" ]; then
                CHARGING=$(cat "$ps/status")
            fi
            if [ -f "$ps/voltage_now" ]; then
                VOLTAGE=$(cat "$ps/voltage_now")
                # microvolts to millivolts
                if [ "$VOLTAGE" -gt 100000 ]; then
                    VOLTAGE=$(( VOLTAGE / 1000 ))
                fi
            fi
            break
        fi
    done
fi

# 3. Check /proc/cmdline
if [ -z "$PERCENT" ] && [ -f /proc/cmdline ]; then
    CMDLINE=$(cat /proc/cmdline)
    for param in $CMDLINE; do
        case "$param" in
            vita_batt=*)
                PERCENT="${param#vita_batt=}"
                ;;
            vita_chg=*)
                CHARGING="${param#vita_chg=}"
                ;;
            vita_volt=*)
                VOLTAGE="${param#vita_volt=}"
                ;;
        esac
    done
fi

# Default fallback if unknown
if [ -z "$PERCENT" ]; then
    PERCENT="Unknown"
fi

if [ "$CHARGING" = "1" ] || [ "$CHARGING" = "Charging" ]; then
    STATUS_STR="Charging (AC Power Connected)"
    SHORT_STATUS="Charging"
elif [ "$CHARGING" = "0" ] || [ "$CHARGING" = "Discharging" ]; then
    STATUS_STR="Discharging (Battery Power)"
    SHORT_STATUS="Discharging"
elif [ -n "$CHARGING" ]; then
    STATUS_STR="$CHARGING"
    SHORT_STATUS="$CHARGING"
else
    STATUS_STR="On Battery"
    SHORT_STATUS="Battery"
fi

# Format progress bar if percentage is a number
BAR=""
if echo "$PERCENT" | grep -q '^[0-9]\+$'; then
    BAR_LEN=20
    FILLED=$(( (PERCENT * BAR_LEN) / 100 ))
    EMPTY=$(( BAR_LEN - FILLED ))
    BAR="["
    i=0; while [ $i -lt $FILLED ]; do BAR="${BAR}="; i=$((i+1)); done
    if [ $FILLED -lt $BAR_LEN ]; then BAR="${BAR}>"; EMPTY=$((EMPTY-1)); fi
    i=0; while [ $i -lt $EMPTY ]; do BAR="${BAR} "; i=$((i+1)); done
    BAR="${BAR}]"
fi

case "$1" in
    --percent|-p)
        echo "${PERCENT}%"
        ;;
    --short|-s)
        if [ -n "$BAR" ]; then
            echo "${PERCENT}% ${SHORT_STATUS}"
        else
            echo "${PERCENT} (${SHORT_STATUS})"
        fi
        ;;
    *)
        echo "======================================================"
        echo "               PlayStation Vita Battery               "
        echo "======================================================"
        if [ -n "$BAR" ]; then
            printf " Battery Level:   %s%% %s\n" "$PERCENT" "$BAR"
        else
            printf " Battery Level:   %s\n" "$PERCENT"
        fi
        printf " Power State:     %s\n" "$STATUS_STR"
        if [ -n "$VOLTAGE" ]; then
            printf " Battery Voltage: %s mV\n" "$VOLTAGE"
        fi
        printf " Battery Health:  Good\n"
        echo "======================================================"
        ;;
esac
