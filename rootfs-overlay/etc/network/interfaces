auto lo
iface lo inet loopback

# Marvell 88W8787 Wi-Fi (mlan0 on mwifiex, wlan0 on generic)
iface mlan0 inet dhcp
    pre-up mkdir -p /var/run/wpa_supplicant && wpa_supplicant -B -i mlan0 -c /etc/wpa_supplicant.conf -O /var/run/wpa_supplicant
    post-down killall wpa_supplicant 2>/dev/null

iface wlan0 inet dhcp
    pre-up mkdir -p /var/run/wpa_supplicant && wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf -O /var/run/wpa_supplicant
    post-down killall wpa_supplicant 2>/dev/null
