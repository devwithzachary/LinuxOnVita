auto lo
iface lo inet loopback

# Marvell 88W8787 Wi-Fi (mlan0 or wlan0)
iface mlan0 inet dhcp
    pre-up wpa_supplicant -B -i mlan0 -c /etc/wpa_supplicant.conf
    post-down killall wpa_supplicant 2>/dev/null

iface wlan0 inet dhcp
    pre-up wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf
    post-down killall wpa_supplicant 2>/dev/null
