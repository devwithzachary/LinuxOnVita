#!/bin/sh
# Create stable /dev/vita/ symlinks for eMMC partitions.
# The SCE partition parser creates 12 partitions - find the mmcblk with p12.

case "$1" in
start)
    EMMC=""
    for dev in /dev/mmcblk[0-9]; do
        [ -b "${dev}p12" ] && EMMC=$dev && break
    done
    [ -z "$EMMC" ] && exit 0

    mkdir -p /dev/vita
    ln -sf ${EMMC}p1  /dev/vita/idstorage
    ln -sf ${EMMC}p2  /dev/vita/slb2-backup
    ln -sf ${EMMC}p3  /dev/vita/slb2
    ln -sf ${EMMC}p4  /dev/vita/os0-backup
    ln -sf ${EMMC}p5  /dev/vita/os0
    ln -sf ${EMMC}p6  /dev/vita/sa0
    ln -sf ${EMMC}p7  /dev/vita/tm0
    ln -sf ${EMMC}p8  /dev/vita/vs0
    ln -sf ${EMMC}p9  /dev/vita/vd0
    ln -sf ${EMMC}p10 /dev/vita/ud0
    ln -sf ${EMMC}p11 /dev/vita/pd0
    ln -sf ${EMMC}p12 /dev/vita/ur0

    # Mount ur0 and ux0 read-only by default to protect VitaOS data
    if command -v vita-storage >/dev/null 2>&1; then
        vita-storage mount all >/dev/null 2>&1 || true
    else
        mkdir -p /mnt/ur0 /mnt/ux0
        if ! grep -qs ' /mnt/ur0 ' /proc/mounts; then
            mount -t exfat -o ro /dev/vita/ur0 /mnt/ur0 2>/dev/null || \
            mount -t vfat -o ro /dev/vita/ur0 /mnt/ur0 2>/dev/null || \
            mount -o ro /dev/vita/ur0 /mnt/ur0 2>/dev/null || true
        fi
        for dev in /dev/mmcblk1p1 /dev/mmcblk1 /dev/mmcblk2p1 /dev/mmcblk2; do
            if [ -b "$dev" ]; then
                ln -sf "$dev" /dev/vita/ux0
                if ! grep -qs ' /mnt/ux0 ' /proc/mounts; then
                    mount -t exfat -o ro "$dev" /mnt/ux0 2>/dev/null || \
                    mount -t vfat -o ro "$dev" /mnt/ux0 2>/dev/null || \
                    mount -t ext4 -o ro "$dev" /mnt/ux0 2>/dev/null || \
                    mount -o ro "$dev" /mnt/ux0 2>/dev/null || true
                fi
                break
            fi
        done
    fi

    # Auto-activate physical swapfile only if explicitly configured in /etc/vita-swap.conf
    SWAP_FILE=""
    [ -f /etc/vita-swap.conf ] && SWAP_FILE=$(cat /etc/vita-swap.conf 2>/dev/null)
    if [ -n "$SWAP_FILE" ] && [ -f "$SWAP_FILE" ]; then
        chmod 600 "$SWAP_FILE" 2>/dev/null || true
        swapon -p 10 "$SWAP_FILE" >/dev/null 2>&1 || true
    fi
    ;;
stop)
    sync 2>/dev/null || true
    swapoff -a 2>/dev/null || true
    sync 2>/dev/null || true
    if command -v vita-storage >/dev/null 2>&1; then
        vita-storage ro all -q 2>/dev/null || true
    fi
    umount -r /mnt/ux0 2>/dev/null || true
    umount -r /mnt/ur0 2>/dev/null || true
    sync 2>/dev/null || true
    ;;
esac
