#!/bin/sh
# Wait for wireless interface (mlan0 or wlan0) and bring up Wi-Fi networking.
# Runs in background so it does not block early console boot.

TIMEOUT=60

case "$1" in
start)
    (
        i=0
        IFACE=""
        while [ $i -lt $TIMEOUT ]; do
            for candidate in mlan0 wlan0; do
                if [ -e "/sys/class/net/$candidate" ] || ip link show "$candidate" >/dev/null 2>&1; then
                    IFACE="$candidate"
                    break 2
                fi
            done
            sleep 1
            i=$((i + 1))
        done

        if [ -n "$IFACE" ]; then
            echo "[WiFi] $IFACE interface detected. Starting association..."

            # Priority 1: user-supplied config on SD card (supports pre-built release installs)
            # Priority 2: credentials baked into the initramfs at build time
            WPA_CONF=""
            for candidate in \
                /mnt/ux0/linux/wpa_supplicant.conf \
                /mnt/xmc0/linux/wpa_supplicant.conf \
                /mnt/uma0/linux/wpa_supplicant.conf \
                /mnt/ux0/wpa_supplicant.conf \
                /etc/wpa_supplicant.conf; do
                if [ -f "$candidate" ]; then
                    # Check if candidate has a network block with real credentials (not unedited template)
                    if grep -q "network=" "$candidate" 2>/dev/null && \
                       ! grep -Eq "YourWiFiNetworkName|YourWiFiSSID|YourNetworkName" "$candidate" 2>/dev/null; then
                        WPA_CONF="$candidate"
                        break
                    fi
                fi
            done

            mkdir -p /var/run/wpa_supplicant

            # Kill any previous/stale instances
            killall wpa_supplicant 2>/dev/null || true
            killall udhcpc 2>/dev/null || true

            ip link set "$IFACE" up 2>/dev/null || true

            if [ -n "$WPA_CONF" ]; then
                echo "[WiFi] Using config: $WPA_CONF"
                echo "[WiFi] Launching wpa_supplicant on $IFACE using $WPA_CONF..."
                wpa_supplicant -B -i "$IFACE" -c "${WPA_CONF}" -O /var/run/wpa_supplicant

                # Wait up to 15s for 802.11 association (carrier state)
                echo "[WiFi] Waiting for $IFACE association..."
                k=0
                while [ $k -lt 15 ]; do
                    if [ "$(cat /sys/class/net/$IFACE/carrier 2>/dev/null || echo 0)" = "1" ]; then
                        echo "[WiFi] $IFACE associated successfully!"
                        break
                    fi
                    sleep 1
                    k=$((k + 1))
                done

                echo "[WiFi] Requesting DHCP lease on $IFACE..."
                udhcpc -i "$IFACE" -b -R 2>/dev/null || true

                # Wait for DHCP lease
                j=0
                IP=""
                while [ $j -lt 25 ]; do
                    IP=$(ip -4 addr show "$IFACE" 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2)
                    [ -n "$IP" ] && break
                    sleep 1
                    j=$((j + 1))
                done

                if [ -n "$IP" ]; then
                    BANNER="
==================================================
  Wi-Fi Connected! IP Address: $IP
  SSH Ready: ssh root@$IP
=================================================="
                    echo "$BANNER"
                    echo "$BANNER" > /dev/tty1 2>/dev/null || true
                    echo "$BANNER" > /dev/kmsg 2>/dev/null || true
                    logger -t wifi "$IFACE connected with IP $IP"
                    # Ensure SSH daemon is active on the new interface
                    /etc/init.d/S50sshd restart 2>/dev/null || /usr/sbin/sshd 2>/dev/null || true
                else
                    echo "[WiFi] $IFACE associated. Waiting for background DHCP..."
                fi
            else
                echo "[WiFi] No wpa_supplicant.conf found. Initializing idle Wi-Fi stack for vita-wifi..."
                cat << 'EOF' > /etc/wpa_supplicant.conf
ctrl_interface=/var/run/wpa_supplicant
update_config=1
EOF
                wpa_supplicant -B -i "$IFACE" -c /etc/wpa_supplicant.conf -O /var/run/wpa_supplicant
                echo "[WiFi] Wi-Fi ready. Run 'vita-wifi' to scan and connect."
            fi
        else
            echo "[WiFi] Wireless interface not detected after ${TIMEOUT}s."
            logger -t wifi "No wireless interface found after ${TIMEOUT}s"
        fi
    ) 2>&1 | tee /tmp/wifi.log &
    echo "Starting Wi-Fi daemon in background..."
    ;;
stop)
    killall wpa_supplicant 2>/dev/null
    killall udhcpc 2>/dev/null
    for iface in mlan0 wlan0; do
        /sbin/ifdown "$iface" 2>/dev/null
        ip link set "$iface" down 2>/dev/null
    done
    echo "Wi-Fi stopped."
    ;;
*)
    echo "Usage: $0 {start|stop}"
    ;;
esac
